/// Generic language-level Result and trait helpers exposed by std.
mod cpu StdLanguageCore {
  pub trait Addable {
    fn add(lhs: Self, rhs: Self) -> Self;
  }

  impl Addable for i64 {
    fn add(lhs: i64, rhs: i64) -> i64 {
      return lhs + rhs;
    }
  }

  pub enum Error { InvalidInput, }

  pub enum Result<T, E> {
    Ok(T), Err(E),
  }

  /// Optional value used by bootstrap-safe compiler collections.
  pub enum Option<T> { Some(T), None, }

  /// Internal four-value page used by the deterministic compiler vector.
  pub struct CompilerVectorPage {
    pub length: i64,
    pub slot0: i64, pub slot1: i64,
    pub slot2: i64, pub slot3: i64
  }

  /// Owned compiler vector with four deterministic four-value pages.
  pub struct CompilerVector {
    pub length: i64, pub page_count: i64,
    pub page0: CompilerVectorPage, pub page1: CompilerVectorPage,
    pub page2: CompilerVectorPage, pub page3: CompilerVectorPage
  }

  /// UTF-8 bytes and deterministic identity owned by the compiler component.
  pub struct CompilerText {
    pub bytes: CompilerVector, pub scalar_length: i64, pub hash: i64
  }

  /// Ordered integer map backed by two deterministic four-page vectors.
  pub struct CompilerMap {
    pub length: i64, pub keys: CompilerVector, pub values: CompilerVector
  }

  /// Stable-index compiler objects stored in four deterministic columns.
  pub struct CompilerArena {
    pub capacity: i64, pub next_index: i64, pub last_index: i64,
    pub kinds: CompilerVector, pub field0s: CompilerVector,
    pub field1s: CompilerVector, pub field2s: CompilerVector
  }

  /// Half-open byte range within one compiler-owned source.
  pub struct CompilerSourceSpan {
    pub source_id: i64, pub start: i64, pub end: i64
  }

  /// Bounded path represented by interned segment identities.
  pub struct CompilerPath {
    pub absolute: bool, pub segments: CompilerVector, pub hash: i64
  }

  /// Owned compiler diagnostic with no host-language layout in its contract.
  pub struct CompilerDiagnostic {
    pub code: i64, pub severity: i64, pub message: CompilerText,
    pub span: CompilerSourceSpan, pub path: CompilerPath
  }

  pub type Alias<T> = T;

  pub type Mapper<T> = Fn1<T, T>;

  /// Builds an Ok result while preserving expected-type inference.
  pub fn ok<T, E>(value: T) -> Result<T, E> {
    return Result.Ok(value);
  }

  /// Builds an Err result while preserving expected-type inference.
  pub fn err<T, E>(error: E) -> Result<T, E> {
    return Result.Err(error);
  }

  pub fn compiler_vector_page_empty(fill: i64) -> CompilerVectorPage {
    return CompilerVectorPage {
      length: 0,
      slot0: fill,
      slot1: fill,
      slot2: fill,
      slot3: fill
    };
  }

  pub fn compiler_vector_page_full(fill: i64) -> CompilerVectorPage {
    return CompilerVectorPage { length: 4, slot0: fill, slot1: fill, slot2: fill, slot3: fill };
  }
  pub fn compiler_vector_full(fill: i64) -> CompilerVector {
    return CompilerVector {
      length: 16,
      page_count: 4,
      page0: compiler_vector_page_full(fill), page1: compiler_vector_page_full(fill),
      page2: compiler_vector_page_full(fill), page3: compiler_vector_page_full(fill)
    };
  }

  pub fn compiler_vector_page_push(
    page: CompilerVectorPage,
    value: i64
  ) -> Result<CompilerVectorPage, i64> {
    if page.length == 0 {
      return Result.Ok(CompilerVectorPage {
        length: 1,
        slot0: value,
        slot1: page.slot1,
        slot2: page.slot2,
        slot3: page.slot3
      });
    }
    if page.length == 1 {
      return Result.Ok(CompilerVectorPage {
        length: 2,
        slot0: page.slot0,
        slot1: value,
        slot2: page.slot2,
        slot3: page.slot3
      });
    }
    if page.length == 2 {
      return Result.Ok(CompilerVectorPage {
        length: 3,
        slot0: page.slot0,
        slot1: page.slot1,
        slot2: value,
        slot3: page.slot3
      });
    }
    if page.length == 3 {
      return Result.Ok(CompilerVectorPage {
        length: 4,
        slot0: page.slot0,
        slot1: page.slot1,
        slot2: page.slot2,
        slot3: value
      });
    }
    return Result.Err(1);
  }

  pub fn compiler_vector_page_get(page: CompilerVectorPage, index: i64) -> Option<i64> {
    if index == 0 && page.length > 0 {
      return Option.Some(page.slot0);
    }
    if index == 1 && page.length > 1 {
      return Option.Some(page.slot1);
    }
    if index == 2 && page.length > 2 {
      return Option.Some(page.slot2);
    }
    if index == 3 && page.length > 3 {
      return Option.Some(page.slot3);
    }
    return Option.None;
  }

  pub fn compiler_vector_page_set(
    page: CompilerVectorPage,
    index: i64,
    value: i64
  ) -> Result<CompilerVectorPage, i64> {
    if index == 0 && page.length > 0 {
      return Result.Ok(CompilerVectorPage {
        length: page.length,
        slot0: value,
        slot1: page.slot1,
        slot2: page.slot2,
        slot3: page.slot3
      });
    }
    if index == 1 && page.length > 1 {
      return Result.Ok(CompilerVectorPage {
        length: page.length,
        slot0: page.slot0,
        slot1: value,
        slot2: page.slot2,
        slot3: page.slot3
      });
    }
    if index == 2 && page.length > 2 {
      return Result.Ok(CompilerVectorPage {
        length: page.length,
        slot0: page.slot0,
        slot1: page.slot1,
        slot2: value,
        slot3: page.slot3
      });
    }
    if index == 3 && page.length > 3 {
      return Result.Ok(CompilerVectorPage {
        length: page.length,
        slot0: page.slot0,
        slot1: page.slot1,
        slot2: page.slot2,
        slot3: value
      });
    }
    return Result.Err(2);
  }

  pub fn compiler_vector_shape_valid(
    length: i64,
    page_count: i64,
    page0_length: i64,
    page1_length: i64,
    page2_length: i64,
    page3_length: i64
  ) -> bool {
    if length == 0 {
      return page_count == 0
        && page0_length == 0 && page1_length == 0
        && page2_length == 0 && page3_length == 0;
    }
    if length > 0 && length <= 4 {
      return page_count == 1
        && page0_length == length && page1_length == 0
        && page2_length == 0 && page3_length == 0;
    }
    if length > 4 && length <= 8 {
      return page_count == 2
        && page0_length == 4 && page1_length == length - 4
        && page2_length == 0 && page3_length == 0;
    }
    if length > 8 && length <= 12 {
      return page_count == 3
        && page0_length == 4 && page1_length == 4
        && page2_length == length - 8 && page3_length == 0;
    }
    if length > 12 && length <= 16 {
      return page_count == 4
        && page0_length == 4 && page1_length == 4
        && page2_length == 4 && page3_length == length - 12;
    }
    return false;
  }

  pub fn compiler_vector_valid(vector: CompilerVector) -> bool {
    return compiler_vector_shape_valid(
      vector.length, vector.page_count,
      vector.page0.length, vector.page1.length,
      vector.page2.length, vector.page3.length
    );
  }

  /// Builds an empty four-page vector using an explicit filler value.
  pub fn compiler_vector_empty(fill: i64) -> CompilerVector {
    return CompilerVector {
      length: 0,
      page_count: 0,
      page0: compiler_vector_page_empty(fill),
      page1: compiler_vector_page_empty(fill),
      page2: compiler_vector_page_empty(fill),
      page3: compiler_vector_page_empty(fill)
    };
  }

  /// Appends one value, opening pages in order, or reports capacity exhaustion.
  pub fn compiler_vector_push(
    vector: CompilerVector,
    value: i64
  ) -> Result<CompilerVector, i64> {
    if compiler_vector_shape_valid(
      vector.length,
      vector.page_count,
      vector.page0.length,
      vector.page1.length,
      vector.page2.length,
      vector.page3.length
    ) == false {
      return Result.Err(3);
    }
    if vector.length < 4 {
      let page: CompilerVectorPage = compiler_vector_page_push(vector.page0, value)?;
      return Result.Ok(CompilerVector {
        length: vector.length + 1,
        page_count: 1,
        page0: page,
        page1: vector.page1,
        page2: vector.page2,
        page3: vector.page3
      });
    }
    if vector.length < 8 {
      let page: CompilerVectorPage = compiler_vector_page_push(vector.page1, value)?;
      return Result.Ok(CompilerVector {
        length: vector.length + 1,
        page_count: 2,
        page0: vector.page0,
        page1: page,
        page2: vector.page2,
        page3: vector.page3
      });
    }
    if vector.length < 12 {
      let page: CompilerVectorPage = compiler_vector_page_push(vector.page2, value)?;
      return Result.Ok(CompilerVector {
        length: vector.length + 1,
        page_count: 3,
        page0: vector.page0,
        page1: vector.page1,
        page2: page,
        page3: vector.page3
      });
    }
    if vector.length < 16 {
      let page: CompilerVectorPage = compiler_vector_page_push(vector.page3, value)?;
      return Result.Ok(CompilerVector {
        length: vector.length + 1,
        page_count: 4,
        page0: vector.page0,
        page1: vector.page1,
        page2: vector.page2,
        page3: page
      });
    }
    return Result.Err(1);
  }

  /// Reads one vector value or returns None for an invalid index.
  pub fn compiler_vector_get(vector: CompilerVector, index: i64) -> Option<i64> {
    if compiler_vector_shape_valid(
      vector.length,
      vector.page_count,
      vector.page0.length,
      vector.page1.length,
      vector.page2.length,
      vector.page3.length
    ) == false || index < 0 || index >= vector.length {
      return Option.None;
    }
    if index < 4 {
      return compiler_vector_page_get(vector.page0, index);
    }
    if index < 8 {
      return compiler_vector_page_get(vector.page1, index - 4);
    }
    if index < 12 {
      return compiler_vector_page_get(vector.page2, index - 8);
    }
    return compiler_vector_page_get(vector.page3, index - 12);
  }

  /// Replaces one vector value or reports an invalid index as error code 2.
  pub fn compiler_vector_set(
    vector: CompilerVector,
    index: i64,
    value: i64
  ) -> Result<CompilerVector, i64> {
    if compiler_vector_shape_valid(
      vector.length,
      vector.page_count,
      vector.page0.length,
      vector.page1.length,
      vector.page2.length,
      vector.page3.length
    ) == false {
      return Result.Err(3);
    }
    if index < 0 || index >= vector.length {
      return Result.Err(2);
    }
    if index < 4 {
      let page: CompilerVectorPage = compiler_vector_page_set(vector.page0, index, value)?;
      return Result.Ok(CompilerVector {
        length: vector.length,
        page_count: vector.page_count,
        page0: page,
        page1: vector.page1,
        page2: vector.page2,
        page3: vector.page3
      });
    }
    if index < 8 {
      let page: CompilerVectorPage = compiler_vector_page_set(vector.page1, index - 4, value)?;
      return Result.Ok(CompilerVector {
        length: vector.length,
        page_count: vector.page_count,
        page0: vector.page0,
        page1: page,
        page2: vector.page2,
        page3: vector.page3
      });
    }
    if index < 12 {
      let page: CompilerVectorPage = compiler_vector_page_set(vector.page2, index - 8, value)?;
      return Result.Ok(CompilerVector {
        length: vector.length,
        page_count: vector.page_count,
        page0: vector.page0,
        page1: vector.page1,
        page2: page,
        page3: vector.page3
      });
    }
    let page: CompilerVectorPage = compiler_vector_page_set(vector.page3, index - 12, value)?;
    return Result.Ok(CompilerVector {
      length: vector.length,
      page_count: vector.page_count,
      page0: vector.page0,
      page1: vector.page1,
      page2: vector.page2,
      page3: page
    });
  }

  /// Appends one already-validated UTF-8 byte for the canonical scalar encoder.
  pub fn compiler_text_append_byte(
    value: CompilerText,
    byte: i64
  ) -> Result<CompilerText, i64> {
    if byte < 0 || byte > 255 {
      return Result.Err(3);
    }
    let next_bytes: CompilerVector = compiler_vector_push(value.bytes, byte)?;
    return Result.Ok(CompilerText {
      bytes: next_bytes,
      scalar_length: value.scalar_length,
      hash: (value.hash * 257 + byte + 1) % 2147483647
    });
  }

  /// Builds empty compiler-owned UTF-8 text.
  pub fn compiler_text_empty() -> CompilerText {
    return CompilerText {
      bytes: compiler_vector_empty(0),
      scalar_length: 0,
      hash: 0
    };
  }

  /// Appends one Unicode scalar and encodes it as canonical UTF-8.
  pub fn compiler_text_push_scalar(
    value: CompilerText,
    scalar: i64
  ) -> Result<CompilerText, i64> {
    if scalar < 0 || scalar > 1114111 {
      return Result.Err(3);
    }
    if scalar >= 55296 && scalar <= 57343 {
      return Result.Err(3);
    }
    if scalar <= 127 {
      let encoded: CompilerText = compiler_text_append_byte(value, scalar)?;
      return Result.Ok(CompilerText {
        bytes: encoded.bytes,
        scalar_length: value.scalar_length + 1,
        hash: encoded.hash
      });
    }
    if scalar <= 2047 {
      let first: CompilerText = compiler_text_append_byte(value, 192 + scalar / 64)?;
      let second: CompilerText = compiler_text_append_byte(first, 128 + scalar % 64)?;
      return Result.Ok(CompilerText {
        bytes: second.bytes,
        scalar_length: value.scalar_length + 1,
        hash: second.hash
      });
    }
    if scalar <= 65535 {
      let first: CompilerText = compiler_text_append_byte(value, 224 + scalar / 4096)?;
      let second: CompilerText = compiler_text_append_byte(
        first,
        128 + (scalar / 64) % 64
      )?;
      let third: CompilerText = compiler_text_append_byte(second, 128 + scalar % 64)?;
      return Result.Ok(CompilerText {
        bytes: third.bytes,
        scalar_length: value.scalar_length + 1,
        hash: third.hash
      });
    }
    let first: CompilerText = compiler_text_append_byte(value, 240 + scalar / 262144)?;
    let second: CompilerText = compiler_text_append_byte(
      first,
      128 + (scalar / 4096) % 64
    )?;
    let third: CompilerText = compiler_text_append_byte(
      second,
      128 + (scalar / 64) % 64
    )?;
    let fourth: CompilerText = compiler_text_append_byte(third, 128 + scalar % 64)?;
    return Result.Ok(CompilerText {
      bytes: fourth.bytes,
      scalar_length: value.scalar_length + 1,
      hash: fourth.hash
    });
  }

  /// Returns the encoded byte length of compiler-owned text.
  pub fn compiler_text_byte_length(value: CompilerText) -> i64 {
    return value.bytes.length;
  }

  /// Builds an empty deterministic compiler map.
  pub fn compiler_map_empty() -> CompilerMap {
    return CompilerMap {
      length: 0, keys: compiler_vector_empty(0), values: compiler_vector_empty(0)
    };
  }
  /// Rejects mismatched key/value columns and malformed vector pages.
  pub fn compiler_map_shape_valid(map: CompilerMap) -> bool {
    if map.length != map.keys.length || map.length != map.values.length { return false; }
    return compiler_vector_valid(map.keys) && compiler_vector_valid(map.values);
  }
  pub fn compiler_map_vector_value(vector: CompilerVector, index: i64) -> i64 {
    match compiler_vector_get(vector, index) {
      Option.Some(value) => { return value; }
      Option.None => { return 0; }
    }
  }
  pub fn compiler_map_replace_value(map: CompilerMap, index: i64, value: i64) -> Result<CompilerMap, i64> {
    let updated: CompilerVector = compiler_vector_set(map.values, index, value)?;
    return Result.Ok(CompilerMap {
      length: map.length, keys: map.keys, values: updated
    });
  }
  pub fn compiler_map_find_index(map: CompilerMap, key: i64, index: i64) -> i64 {
    if index < 0 || index >= map.length { return -1; }
    if compiler_map_vector_value(map.keys, index) == key { return index; }
    return compiler_map_find_index(map, key, index + 1);
  }
  /// Inserts in stable order or replaces the value at an existing key index.
  pub fn compiler_map_insert(map: CompilerMap, key: i64, value: i64) -> Result<CompilerMap, i64> {
    if compiler_map_shape_valid(map) == false { return Result.Err(3); }
    let index: i64 = compiler_map_find_index(map, key, 0);
    if index >= 0 { return compiler_map_replace_value(map, index, value); }
    let keys: CompilerVector = compiler_vector_push(map.keys, key)?;
    let values: CompilerVector = compiler_vector_push(map.values, value)?;
    return Result.Ok(CompilerMap {
      length: map.length + 1, keys: keys, values: values
    });
  }
  /// Looks up one compiler map value without exposing storage layout.
  pub fn compiler_map_get(map: CompilerMap, key: i64) -> Option<i64> {
    if compiler_map_shape_valid(map) == false { return Option.None; }
    let index: i64 = compiler_map_find_index(map, key, 0);
    if index >= 0 { return Option.Some(compiler_map_vector_value(map.values, index)); }
    return Option.None;
  }
  /// Reports key presence without exposing Option lowering to callers.
  pub fn compiler_map_contains(map: CompilerMap, key: i64) -> bool {
    match compiler_map_get(map, key) {
      Option.Some(_) => { return true; }
      Option.None => { return false; }
    }
  }
  pub fn compiler_map_identity_fold(state: i64, value: i64) -> i64 {
    let normalized: i64 = value % 2147483629;
    if normalized < 0 {
      return ((state * 257) + normalized + 2147483630) % 2147483629;
    }
    return ((state * 257) + normalized + 1) % 2147483629;
  }
  pub fn compiler_map_identity_from(map: CompilerMap, index: i64, identity: i64) -> i64 {
    if index >= map.length { return identity; }
    let key_identity: i64 = compiler_map_identity_fold(
      identity,
      compiler_map_vector_value(map.keys, index)
    );
    let value_identity: i64 = compiler_map_identity_fold(
      key_identity,
      compiler_map_vector_value(map.values, index)
    );
    return compiler_map_identity_from(map, index + 1, value_identity);
  }
  /// Hashes length plus every key/value pair in insertion order.
  pub fn compiler_map_identity(map: CompilerMap) -> Result<i64, i64> {
    if compiler_map_shape_valid(map) == false { return Result.Err(3); }
    let identity: i64 = compiler_map_identity_fold(211, map.length);
    return Result.Ok(compiler_map_identity_from(map, 0, identity));
  }

  pub fn compiler_arena_shape_valid(arena: CompilerArena) -> bool {
    if arena.capacity < 0 || arena.capacity > 16
      || arena.next_index < 0 || arena.next_index > arena.capacity {
      return false;
    }
    if arena.next_index != arena.kinds.length
      || arena.next_index != arena.field0s.length
      || arena.next_index != arena.field1s.length
      || arena.next_index != arena.field2s.length {
      return false;
    }
    if arena.next_index == 0 && arena.last_index != -1 { return false; }
    if arena.next_index > 0 && arena.last_index != arena.next_index - 1 {
      return false;
    }
    return compiler_vector_valid(arena.kinds)
      && compiler_vector_valid(arena.field0s)
      && compiler_vector_valid(arena.field1s)
      && compiler_vector_valid(arena.field2s);
  }

  /// Builds an empty bounded arena with an explicit capacity.
  pub fn compiler_arena_new(capacity: i64) -> Result<CompilerArena, i64> {
    if capacity < 0 || capacity > 16 { return Result.Err(3); }
    return Result.Ok(CompilerArena {
      capacity: capacity,
      next_index: 0,
      last_index: -1,
      kinds: compiler_vector_empty(0),
      field0s: compiler_vector_empty(0),
      field1s: compiler_vector_empty(0),
      field2s: compiler_vector_empty(0)
    });
  }

  /// Stores one four-scalar object envelope at the next stable index.
  pub fn compiler_arena_store(
    arena: CompilerArena,
    kind: i64,
    field0: i64,
    field1: i64,
    field2: i64
  ) -> Result<CompilerArena, i64> {
    if compiler_arena_shape_valid(arena) == false || kind < 0
      || (kind == 0 && (field0 != 0 || field1 != 0 || field2 != 0)) {
      return Result.Err(3);
    }
    if arena.next_index >= arena.capacity { return Result.Err(1); }
    let kinds: CompilerVector = compiler_vector_push(arena.kinds, kind)?;
    let field0s: CompilerVector = compiler_vector_push(arena.field0s, field0)?;
    let field1s: CompilerVector = compiler_vector_push(arena.field1s, field1)?;
    let field2s: CompilerVector = compiler_vector_push(arena.field2s, field2)?;
    return Result.Ok(CompilerArena {
      capacity: arena.capacity,
      next_index: arena.next_index + 1,
      last_index: arena.next_index,
      kinds: kinds, field0s: field0s, field1s: field1s, field2s: field2s
    });
  }

  /// Allocates a reserved kind-zero object for the compatibility surface.
  pub fn compiler_arena_allocate(arena: CompilerArena) -> Result<CompilerArena, i64> {
    return compiler_arena_store(arena, 0, 0, 0, 0);
  }

  /// Reads kind at slot zero or one of three object fields at slots one to three.
  pub fn compiler_arena_object_value(
    arena: CompilerArena,
    index: i64,
    slot: i64
  ) -> Option<i64> {
    if compiler_arena_shape_valid(arena) == false
      || index < 0 || index >= arena.next_index {
      return Option.None;
    }
    if slot == 0 { return compiler_vector_get(arena.kinds, index); }
    if slot == 1 { return compiler_vector_get(arena.field0s, index); }
    if slot == 2 { return compiler_vector_get(arena.field1s, index); }
    if slot == 3 { return compiler_vector_get(arena.field2s, index); }
    return Option.None;
  }

  pub fn compiler_arena_identity_from(
    arena: CompilerArena,
    index: i64,
    identity: i64
  ) -> i64 {
    if index >= arena.next_index { return identity; }
    let kind: i64 = compiler_map_identity_fold(
      identity, compiler_map_vector_value(arena.kinds, index)
    );
    let field0: i64 = compiler_map_identity_fold(
      kind, compiler_map_vector_value(arena.field0s, index)
    );
    let field1: i64 = compiler_map_identity_fold(
      field0, compiler_map_vector_value(arena.field1s, index)
    );
    let field2: i64 = compiler_map_identity_fold(
      field1, compiler_map_vector_value(arena.field2s, index)
    );
    return compiler_arena_identity_from(arena, index + 1, field2);
  }

  /// Hashes object count and every object field in stable index order.
  pub fn compiler_arena_identity(arena: CompilerArena) -> Result<i64, i64> {
    if compiler_arena_shape_valid(arena) == false { return Result.Err(3); }
    let identity: i64 = compiler_map_identity_fold(307, arena.next_index);
    return Result.Ok(compiler_arena_identity_from(arena, 0, identity));
  }

  /// Validates and builds one half-open source span.
  pub fn compiler_source_span(
    source_id: i64,
    start: i64,
    end: i64
  ) -> Result<CompilerSourceSpan, i64> {
    if source_id < 0 || start < 0 || end < start {
      return Result.Err(3);
    }
    return Result.Ok(CompilerSourceSpan {
      source_id: source_id,
      start: start,
      end: end
    });
  }

  /// Returns the byte width of one valid source span.
  pub fn compiler_source_span_width(span: CompilerSourceSpan) -> i64 {
    return span.end - span.start;
  }

  /// Builds an empty compiler path using interned segment identities.
  pub fn compiler_path_empty(absolute: bool) -> CompilerPath {
    return CompilerPath {
      absolute: absolute,
      segments: compiler_vector_empty(0),
      hash: 0
    };
  }

  /// Appends one non-negative interned path segment identity.
  pub fn compiler_path_push(
    path: CompilerPath,
    segment: i64
  ) -> Result<CompilerPath, i64> {
    if segment < 0 {
      return Result.Err(3);
    }
    let segments: CompilerVector = compiler_vector_push(path.segments, segment)?;
    return Result.Ok(CompilerPath {
      absolute: path.absolute,
      segments: segments,
      hash: (path.hash * 131 + segment + 1) % 2147483647
    });
  }

  /// Builds a compiler diagnostic after validating its stable scalar fields.
  pub fn compiler_diagnostic(
    code: i64,
    severity: i64,
    message: CompilerText,
    span: CompilerSourceSpan,
    path: CompilerPath
  ) -> Result<CompilerDiagnostic, i64> {
    if code <= 0 || severity < 0 || severity > 2 {
      return Result.Err(3);
    }
    return Result.Ok(CompilerDiagnostic {
      code: code,
      severity: severity,
      message: message,
      span: span,
      path: path
    });
  }

  /// Scores a diagnostic through owned compiler data only.
  pub fn compiler_diagnostic_score(value: CompilerDiagnostic) -> i64 {
    return value.code
      + value.severity
      + value.message.bytes.length
      + value.message.scalar_length
      + compiler_source_span_width(value.span)
      + value.path.segments.length;
  }

  /// Maps an Ok payload and preserves Err values.
  pub fn result_map<T, R, E>(
    result: Result<T, E>,
    mapper: Fn1<T, R>
  ) -> Result<R, E> {
    match result {
      Result.Ok(value) => {
        return Result.Ok(mapper(value));
      }
      Result.Err(error) => {
        return Result.Err(error);
      }
    }
  }

  /// Extracts an Ok payload or returns the fallback.
  pub fn result_unwrap_or<T, E>(result: Result<T, E>, fallback: T) -> T {
    match result {
      Result.Ok(value) => {
        return value;
      }
      Result.Err(_) => {
        return fallback;
      }
    }
  }

  /// Validates a positive seed through the std language Result surface.
  pub fn fetch(seed: i64) -> Result<i64, Error> {
    if seed <= 0 {
      return Result.Err(Error.InvalidInput);
    }
    return Result.Ok(seed);
  }
}
