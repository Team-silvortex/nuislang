/// Provider-neutral NS Nova application and frame lifecycle.
mod cpu NovaAppRuntime {
  /// Host close intent, not proof that the provider completed successfully.
  pub enum NovaCloseReason { Requested, EventFailed, HostFailed, Unknown }

  /// nuis-yir-application-failure-v2; independent from close intent.
  pub enum NovaFailureKind {
    None, Callback, Host, DispatchLimit, ProviderRejected,
    ProviderExchange, ProviderContract, ReplayExhausted, Unclassified,
    ProviderBudget, ProviderExecution, ProviderFinalization, Unknown
  }

  /// Terminal observation, not app state, completion authority or a resource handle.
  pub struct NovaAppOutcome {
    pub status: i64,
    pub cleanup_completed: i64,
    pub failure_kind: i64
  }

  pub struct NovaAppState {
    pub status: i64,
    pub width: i64,
    pub height: i64,
    pub target_fps: i64,
    pub frame_index: i64,
    pub timeline_tick: i64,
    pub presented_frames: i64,
    pub dropped_frames: i64,
    pub last_completion_token: i64,
    pub last_completion_tick: i64,
    pub last_completion_root: i64,
    pub failure_kind: i64
  }

  pub struct NovaFrameTransaction {
    pub phase: i64,
    pub width: i64,
    pub height: i64,
    pub target_fps: i64,
    pub frame_index: i64,
    pub begin_tick: i64,
    pub deadline_tick: i64,
    pub presented_frames: i64,
    pub dropped_frames: i64,
    pub render_ready: i64,
    pub present_requested: i64,
    pub completion_token: i64,
    pub completion_tick: i64,
    pub completion_root: i64
  }

  pub struct NovaFrameResultHandle {
    pub token: i64,
    pub frame_index: i64,
    pub completion_tick: i64,
    pub root: i64,
    pub provider_ready: i64,
    pub consumed: i64
  }

  pub fn status_running() -> i64 {
    return 1;
  }

  pub fn status_stopped() -> i64 {
    return 2;
  }

  pub fn status_invalid() -> i64 {
    return 3;
  }

  pub fn status_failed() -> i64 {
    return 4;
  }

  /// nuis-yir-application-close-reason-v1; unknown codes fail closed.
  pub fn close_reason(code: i64) -> NovaCloseReason {
    if code == 0 { return NovaCloseReason.Requested; }
    if code == 1 { return NovaCloseReason.EventFailed; }
    if code == 2 { return NovaCloseReason.HostFailed; }
    return NovaCloseReason.Unknown;
  }

  pub fn close_requested(reason: NovaCloseReason) -> bool {
    match reason {
      NovaCloseReason.Requested => { return true; }
      _ => { return false; }
    }
  }

  pub fn failure_kind(code: i64) -> NovaFailureKind {
    if code == 0 { return NovaFailureKind.None; }
    if code == 1 { return NovaFailureKind.Callback; }
    if code == 2 { return NovaFailureKind.Host; }
    if code == 3 { return NovaFailureKind.DispatchLimit; }
    if code == 4 { return NovaFailureKind.ProviderRejected; }
    if code == 5 { return NovaFailureKind.ProviderExchange; }
    if code == 6 { return NovaFailureKind.ProviderContract; }
    if code == 7 { return NovaFailureKind.ReplayExhausted; }
    if code == 8 { return NovaFailureKind.Unclassified; }
    if code == 9 { return NovaFailureKind.ProviderBudget; }
    if code == 10 { return NovaFailureKind.ProviderExecution; }
    if code == 11 { return NovaFailureKind.ProviderFinalization; }
    return NovaFailureKind.Unknown;
  }

  pub fn failure_code(kind: NovaFailureKind) -> i64 {
    match kind {
      NovaFailureKind.None => { return 0; }
      NovaFailureKind.Callback => { return 1; }
      NovaFailureKind.Host => { return 2; }
      NovaFailureKind.DispatchLimit => { return 3; }
      NovaFailureKind.ProviderRejected => { return 4; }
      NovaFailureKind.ProviderExchange => { return 5; }
      NovaFailureKind.ProviderContract => { return 6; }
      NovaFailureKind.ReplayExhausted => { return 7; }
      NovaFailureKind.Unclassified => { return 8; }
      NovaFailureKind.ProviderBudget => { return 9; }
      NovaFailureKind.ProviderExecution => { return 10; }
      NovaFailureKind.ProviderFinalization => { return 11; }
      _ => { return 255; }
    }
  }

  pub fn reason_failure(reason: NovaCloseReason) -> NovaFailureKind {
    match reason {
      NovaCloseReason.Requested => { return NovaFailureKind.None; }
      NovaCloseReason.EventFailed => { return NovaFailureKind.Callback; }
      NovaCloseReason.HostFailed => { return NovaFailureKind.Host; }
      _ => { return NovaFailureKind.Unknown; }
    }
  }

  /// nuis-yir-application-outcome-v1: succeeded=1, failed=2; invalid input=3.
  /// A completed close can coexist with failed Finish. Never call close again.
  pub fn terminal_outcome(status: i64, cleanup: i64, failure: i64) -> NovaAppOutcome {
    if status == 1 && cleanup == 1 && failure == 0 {
      return NovaAppOutcome { status: 1, cleanup_completed: 1, failure_kind: 0 };
    }
    let known: i64 = failure_code(failure_kind(failure));
    if status == 2 && (cleanup == 0 || cleanup == 1) && known != 0 && known != 255 {
      return NovaAppOutcome { status: 2, cleanup_completed: cleanup, failure_kind: known };
    }
    return NovaAppOutcome { status: 3, cleanup_completed: 0, failure_kind: 255 };
  }

  pub fn outcome_succeeded(outcome: NovaAppOutcome) -> bool {
    return outcome.status == 1 && outcome.cleanup_completed == 1 && outcome.failure_kind == 0;
  }

  pub fn outcome_failed(outcome: NovaAppOutcome) -> bool {
    let checked: NovaAppOutcome = terminal_outcome(
      outcome.status, outcome.cleanup_completed, outcome.failure_kind
    );
    return checked.status == 2;
  }

  pub fn phase_begun() -> i64 {
    return 1;
  }

  pub fn phase_submitted() -> i64 {
    return 2;
  }

  pub fn phase_rejected() -> i64 {
    return 3;
  }

  pub fn valid_config(width: i64, height: i64, target_fps: i64) -> bool {
    return width > 0 && height > 0 && target_fps > 0;
  }

  /// Rebuilds the nuis-yir-provider-completion-receipt-v1 token in Nuis code.
  pub fn completion_receipt_token(root: i64, completion_tick: i64) -> i64 {
    let mixed: i64 = i64_xor(root, completion_tick);
    let positive: i64 = if mixed > 0 { mixed } else { 1 };
    return if positive % 2 == 0 { positive + 1 } else { positive };
  }

  pub fn completion_receipt_matches(
    token: i64,
    completion_tick: i64,
    root: i64
  ) -> bool {
    return token > 0 && completion_tick >= 0 && root > 0 &&
      token == completion_receipt_token(root, completion_tick);
  }

  pub fn open(
    width: i64,
    height: i64,
    target_fps: i64,
    initial_tick: i64
  ) -> NovaAppState {
    let status: i64 = if valid_config(width, height, target_fps) {
      status_running()
    } else {
      status_invalid()
    };
    return NovaAppState {
      status: status,
      width: width,
      height: height,
      target_fps: target_fps,
      frame_index: 0,
      timeline_tick: initial_tick,
      presented_frames: 0,
      dropped_frames: 0,
      last_completion_token: 0,
      last_completion_tick: initial_tick,
      last_completion_root: 0,
      failure_kind: 0
    };
  }

  pub fn begin_frame(
    state: NovaAppState,
    observed_tick: i64
  ) -> NovaFrameTransaction {
    let running: bool = state.status == status_running();
    let interval: i64 = if running { 1 } else { 0 };
    let phase: i64 = if running { phase_begun() } else { phase_rejected() };
    return NovaFrameTransaction {
      phase: phase,
      width: state.width,
      height: state.height,
      target_fps: state.target_fps,
      frame_index: state.frame_index,
      begin_tick: observed_tick,
      deadline_tick: observed_tick + interval,
      presented_frames: state.presented_frames,
      dropped_frames: state.dropped_frames,
      render_ready: 0,
      present_requested: 0,
      completion_token: 0,
      completion_tick: observed_tick,
      completion_root: state.last_completion_root
    };
  }

  pub fn capture_frame_result(
    frame: NovaFrameTransaction,
    provider_ready: i64,
    provider_token: i64,
    completion_tick: i64,
    completion_root: i64
  ) -> NovaFrameResultHandle {
    let completed: bool =
      frame.phase == phase_begun() &&
      provider_ready == 1 &&
      provider_token > 0 &&
      completion_root > 0 &&
      completion_tick >= frame.begin_tick &&
      completion_receipt_matches(provider_token, completion_tick, completion_root) &&
      (frame.completion_root == 0 || frame.completion_root == completion_root);
    return NovaFrameResultHandle {
      token: if completed { provider_token } else { 0 },
      frame_index: frame.frame_index,
      completion_tick: completion_tick,
      root: if completed { completion_root } else { 0 },
      provider_ready: provider_ready,
      consumed: 0
    };
  }

  pub fn frame_result_ready(
    frame: NovaFrameTransaction,
    result: NovaFrameResultHandle
  ) -> bool {
    return
      result.token > 0 &&
      result.root > 0 &&
      result.frame_index == frame.frame_index &&
      result.completion_tick >= frame.begin_tick &&
      completion_receipt_matches(result.token, result.completion_tick, result.root) &&
      (frame.completion_root == 0 || frame.completion_root == result.root) &&
      result.provider_ready == 1 &&
      result.consumed == 0;
  }

  pub fn submit_frame(
    frame: NovaFrameTransaction,
    result: NovaFrameResultHandle
  ) -> NovaFrameTransaction {
    let accepted: bool = frame_result_ready(frame, result);
    return NovaFrameTransaction {
      phase: if accepted { phase_submitted() } else { phase_rejected() },
      width: frame.width,
      height: frame.height,
      target_fps: frame.target_fps,
      frame_index: frame.frame_index,
      begin_tick: frame.begin_tick,
      deadline_tick: frame.deadline_tick,
      presented_frames: frame.presented_frames,
      dropped_frames: frame.dropped_frames,
      render_ready: result.provider_ready,
      present_requested: if accepted { 1 } else { 0 },
      completion_token: if accepted { result.token } else { 0 },
      completion_tick: result.completion_tick,
      completion_root: if accepted { result.root } else { 0 }
    };
  }

  pub fn commit_frame(frame: NovaFrameTransaction) -> NovaAppState {
    let presented: bool =
      frame.phase == phase_submitted() &&
      frame.present_requested == 1 &&
      frame.render_ready == 1 &&
      frame.completion_token > 0 &&
      frame.completion_root > 0;
    return NovaAppState {
      status: status_running(),
      width: frame.width,
      height: frame.height,
      target_fps: frame.target_fps,
      frame_index: frame.frame_index + 1,
      timeline_tick: if presented { frame.completion_tick } else { frame.deadline_tick },
      presented_frames: frame.presented_frames + if presented { 1 } else { 0 },
      dropped_frames: frame.dropped_frames + if presented { 0 } else { 1 },
      last_completion_token: if presented { frame.completion_token } else { 0 },
      last_completion_tick: frame.completion_tick,
      last_completion_root: if presented { frame.completion_root } else { 0 },
      failure_kind: 0
    };
  }

  pub fn close(state: NovaAppState, observed_tick: i64) -> NovaAppState {
    return close_with_reason(state, observed_tick, NovaCloseReason.Requested);
  }

  /// Cleanup preserves frame/completion identity and never clears failure.
  pub fn close_with_reason(
    state: NovaAppState,
    observed_tick: i64,
    reason: NovaCloseReason
  ) -> NovaAppState {
    return close_with_failure(state, observed_tick, reason, reason_failure(reason));
  }

  /// First failure wins; neither a normal close nor later faults erase it.
  pub fn close_with_failure(
    state: NovaAppState,
    observed_tick: i64,
    reason: NovaCloseReason,
    failure: NovaFailureKind
  ) -> NovaAppState {
    let reported: i64 = failure_code(failure);
    let fallback: i64 = failure_code(reason_failure(reason));
    let selected: i64 = if reported != 0 { reported } else { fallback };
    let retained: i64 = if state.failure_kind != 0 { state.failure_kind } else { selected };
    let effective: i64 = if retained == 0 && state.status == status_failed() { 8 } else { retained };
    let stopped: bool = close_requested(reason) && state.status != status_failed() && effective == 0;
    return NovaAppState {
      status: if stopped { status_stopped() } else { status_failed() },
      width: state.width,
      height: state.height,
      target_fps: state.target_fps,
      frame_index: state.frame_index,
      timeline_tick: observed_tick,
      presented_frames: state.presented_frames,
      dropped_frames: state.dropped_frames,
      last_completion_token: state.last_completion_token,
      last_completion_tick: state.last_completion_tick,
      last_completion_root: state.last_completion_root,
      failure_kind: effective
    };
  }

  pub fn summary(state: NovaAppState) -> i64 {
    return state.status +
      state.width +
      state.height +
      state.target_fps +
      state.frame_index +
      state.timeline_tick +
      state.presented_frames +
      state.dropped_frames +
      state.last_completion_token +
      state.last_completion_tick +
      state.last_completion_root +
      state.failure_kind;
  }
}
