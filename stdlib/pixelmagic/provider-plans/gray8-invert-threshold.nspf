# PixelMagic-owned provider filter plan.
protocol=nuis-pixelmagic-filter-plan-v1
package_id=nuis.pixelmagic
plan_id=pixelmagic.gray8.invert-threshold
backend_family=metal
target_device=apple-silicon-gpu
buffer.id=input.pixels
buffer.element_type=u8
buffer.layout=image-2d-row-major:pixel-format=gray8
buffer.shape=2x2
buffer.row_stride_bytes=2
buffer.payload_path=nuis.pixelmagic.std-preprocessed.gray8.bin
buffer.payload_bytes=0,4,9,8
stage_order=invert,threshold
stage.invert.request_id=pixelmagic.gray8.invert
stage.invert.operation=invert
stage.invert.scalar_bindings=max_value:u8:15
stage.invert.output_buffer=output.pixels.invert
stage.invert.expected_path=nuis.pixelmagic.std-preprocessed.gray8-invert.expected.bin
stage.invert.expected_bytes=15,11,6,7
stage.invert.input_source=artifact
stage.invert.producer_request_id=none
stage.invert.producer_output_buffer=none
stage.threshold.request_id=pixelmagic.gray8.threshold
stage.threshold.operation=threshold
stage.threshold.scalar_bindings=threshold:u8:8,max_value:u8:15
stage.threshold.output_buffer=output.pixels.threshold
stage.threshold.expected_path=nuis.pixelmagic.std-preprocessed.gray8-threshold.expected.bin
stage.threshold.expected_bytes=15,15,0,0
stage.threshold.input_source=dependency
stage.threshold.producer_request_id=pixelmagic.gray8.invert
stage.threshold.producer_output_buffer=output.pixels.invert
