/// Packed RGBA8 image construction. Each Buffer element is one unsigned 32-bit pixel.
mod cpu PixelMagicPixels {
  /// Red-pixel count and sum of packed RGBA8 values. Invalid input returns (-1, 0).
  pub struct CheckerboardStats { pub red_count: i64, pub checksum: i64 }

  fn checkerboard_parity(x: i64, y: i64, tile_size: i64) -> i64 {
    return (x / tile_size + y / tile_size) % 2;
  }

  fn checkerboard_is_red(index: i64, width: i64, tile_size: i64, phase: i64) -> bool {
    if width <= 0 || tile_size <= 0 || index < 0 { return false; }
    if phase < 0 || phase > 1 { return false; }
    let x: i64 = index % width;
    let y: i64 = index / width;
    let base_red: bool = checkerboard_parity(x, y, tile_size) == 0;
    if phase == 0 { return base_red; }
    return base_red == false;
  }

  fn checkerboard_red_total(total: i64, red: bool) -> i64 {
    if red { return total + 1; }
    return total;
  }

  fn checkerboard_row_start(row: i64, width: i64, start: i64) -> i64 {
    let first: i64 = row * width;
    if first < start { return start; }
    return first;
  }

  fn checkerboard_row_end(row: i64, width: i64, end: i64) -> i64 {
    let last: i64 = (row + 1) * width;
    if last > end { return end; }
    return last;
  }

  /// Fills caller-owned storage; rejects invalid dimensions before changing any pixel.
  pub fn fill_checkerboard(
    pixels: ref Buffer,
    width: i64,
    height: i64,
    tile_size: i64,
    phase: i64
  ) -> bool {
    if width <= 0 || height <= 0 || width > 2048 || height > 2048 {
      return false;
    }
    if tile_size <= 0 || tile_size > 2048 || phase < 0 || phase > 1 {
      return false;
    }
    let count: i64 = width * height;
    if pixels.len != count { return false; }
    return fill_checkerboard_region(pixels, 0, count, width, tile_size, phase);
  }

  /// Fills a bounded pixel range with unit-step row and pixel loops over caller-owned storage.
  pub fn fill_checkerboard_region(
    pixels: ref Buffer, start: i64, end: i64, width: i64, tile_size: i64, phase: i64
  ) -> bool {
    return fill_checkerboard_region_red_count(pixels, start, end, width, tile_size, phase) >= 0;
  }

  /// Fills the range and returns its red-pixel count, or -1 before any write on invalid input.
  pub fn fill_checkerboard_region_red_count(
    pixels: ref Buffer, start: i64, end: i64, width: i64, tile_size: i64, phase: i64
  ) -> i64 {
    let stats: CheckerboardStats = fill_checkerboard_region_stats(pixels, start, end, width, tile_size, phase);
    return stats.red_count;
  }

  /// Computes statistics during the same pass that writes the bounded pixel range.
  pub fn fill_checkerboard_region_stats(
    pixels: ref Buffer, start: i64, end: i64, width: i64, tile_size: i64, phase: i64
  ) -> CheckerboardStats {
    if width <= 0 || width > 2048 || tile_size <= 0 || tile_size > 2048 {
      return CheckerboardStats { red_count: 0 - 1, checksum: 0 };
    }
    if phase < 0 || phase > 1 || start < 0 || start > end || end > pixels.len {
      return CheckerboardStats { red_count: 0 - 1, checksum: 0 };
    }
    if pixels.len > 4194304 || pixels.len % width != 0 {
      return CheckerboardStats { red_count: 0 - 1, checksum: 0 };
    }
    if start == end { return CheckerboardStats { red_count: 0, checksum: 0 }; }
    let total: i64 = 0;
    let checksum: i64 = 0;
    let row: i64 = start / width;
    let rows: i64 = (end + width - 1) / width;
    while row < rows {
      let index: i64 = checkerboard_row_start(row, width, start);
      let row_end: i64 = checkerboard_row_end(row, width, end);
      while index < row_end {
        let red: bool = checkerboard_is_red(index, width, tile_size, phase);
        // Only the selected arm writes its packed little-endian RGBA8 color.
        if red {
          pixels[index] = 4278190335;
          let total: i64 = checkerboard_red_total(total, red);
        } else {
          pixels[index] = 4294901760;
        }
        let checksum: i64 = checksum + pixels[index];
        let index: i64 = index + 1;
      }
      let row: i64 = row + 1;
    }
    return CheckerboardStats { red_count: total, checksum: checksum };
  }
}
