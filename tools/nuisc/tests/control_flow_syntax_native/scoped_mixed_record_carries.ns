mod cpu Main {
    struct Packet { count: i64, enabled: bool }
    @noinline fn advance(value: Packet, divisor: i64) -> Packet {
        return Packet { enabled: !value.enabled, count: value.count + 6 / divisor };
    }
    @noinline fn walk(limit: i64, divisor: i64) -> Packet {
        let carry = Packet { enabled: true, count: 7 };
        let saved = carry;
        let i = 0;
        while i < limit {
            let i = i + 1;
            let carry = advance(carry, divisor);
            if i == 3 { break; }
        }
        return Packet { enabled: carry.enabled, count: carry.count + saved.count };
    }
    fn main() -> i64 {
        let result = walk(5, 2);
        if result.enabled { return 200; }
        let zero = walk(0, 0);
        if zero.enabled { return result.count + zero.count; }
        return 201;
    }
}
