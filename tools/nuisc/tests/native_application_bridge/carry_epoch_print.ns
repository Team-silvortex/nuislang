mod cpu Main {
    struct State { total: i64 }
    @noinline fn observe(value: i64, divisor: i64) -> i64 { return value + 0 / divisor; }
    @noinline fn finish(value: i64, divisor: i64) -> i64 { return value + 0 / divisor; }
    @noinline fn work(seed: State, selected: bool, trips: i64, delta: i64, divisor: i64, tail: i64) -> State {
        print(70);
        let mut index = 0;
        let mut current = seed.total;
        while index < trips {
            print(71);
            if selected { print(observe(current, divisor - index)); }
            print(current);
            current = current + delta;
            print(current);
            index = index + 1;
        }
        print(73);
        return State { total: finish(current, tail) };
    }
    fn start(initial: i64, selected: bool, trips: i64, delta: i64, divisor: i64, tail: i64) -> State {
        print(90);
        return work(State { total: initial }, selected, trips, delta, divisor, tail);
    }
    fn step(state: State, initial: i64, selected: bool, trips: i64, delta: i64, divisor: i64, tail: i64) -> State {
        print(91);
        return work(state, selected, trips, delta, divisor, tail);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
