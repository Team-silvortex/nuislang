mod cpu Main {
    struct State { total: i32 }
    struct Pair { total: i32, tag: i64, flag: bool }
    struct Outer { inner: Pair }
    @noinline fn observe(value: i32, divisor: i64) -> i64 { if value < i32_from_i64(0) { return -1 + 0 / divisor; } if value == i32_from_i64(0) { return 0 / divisor; } return 1 + 0 / divisor; }
    @noinline fn finish(value: i32, divisor: i64) -> i32 { return value + i32_from_i64(0 / divisor); }
    @noinline fn work(seed: State, selected: bool, trips: i64, children: i64, delta: i64, divisor: i64, tail: i64) -> State {
        print(70);
        let mut index = 0;
        let mut current = Outer { inner: Pair { total: seed.total, tag: 100, flag: true } };
        while index < trips {
            print(71);
            print(observe(current.inner.total, 1));
            print(current.inner.tag);
            current = Outer { inner: Pair { total: current.inner.total + i32_from_i64(delta), tag: current.inner.tag + 1, flag: true } };
            let mut local = current;
            let mut child = 0;
            while child < children {
                print(72);
                if selected { print(observe(local.inner.total, divisor - index - child)); }
                print(observe(local.inner.total, 1));
                print(local.inner.tag);
                local = Outer { inner: Pair { total: local.inner.total + i32_from_i64(delta), tag: local.inner.tag + 2, flag: true } };
                print(observe(local.inner.total, 1));
                print(local.inner.tag);
                child = child + 1;
            }
            print(74);
            current = local;
            index = index + 1;
        }
        print(73);
        return State { total: finish(current.inner.total, tail) };
    }
    fn start(initial: i64, selected: bool, trips: i64, children: i64, delta: i64, divisor: i64, tail: i64) -> State {
        print(90);
        return work(State { total: i32_from_i64(initial) }, selected, trips, children, delta, divisor, tail);
    }
    fn step(state: State, initial: i64, selected: bool, trips: i64, children: i64, delta: i64, divisor: i64, tail: i64) -> State {
        print(91);
        return work(state, selected, trips, children, delta, divisor, tail);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
