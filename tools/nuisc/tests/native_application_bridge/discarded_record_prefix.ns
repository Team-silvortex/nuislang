mod cpu Main {
    struct State { total: i64 }
    struct Leaf { value: i64, unused: i64 }
    struct Record { leaf: Leaf, tag: bool, check: i64 }
    struct Packet { value: i64, unused: i64 }
    @noinline fn discarded_decide(inner: bool, condition: i64) -> bool {
        return inner == (1 / condition != 0);
    }
    @noinline fn discarded_first(divisor: i64) -> i64 { return 1 / divisor; }
    @noinline fn discarded_last(divisor: i64) -> i64 { return 1 / divisor; }
    @noinline fn packet(outer: bool, inner: bool, condition: i64, first: i64, last: i64, value: i64, tail: i64) -> Packet {
        print(81);
        let picked: i64 = if outer {
            let unused: Record = if discarded_decide(inner, condition) {
                const p: i64 = discarded_first(first);
                Record { leaf: Leaf { value: p, unused: discarded_last(last) }, tag: true, check: value }
            } else { Record { leaf: Leaf { value: 0, unused: 0 }, tag: false, check: 0 } };
            value
        } else {
            let unused: Record = if discarded_decide(inner, condition) {
                Record { leaf: Leaf { value: 0, unused: 0 }, tag: false, check: 0 }
            } else {
                const p: i64 = discarded_last(last);
                Record { tag: false, check: value, leaf: Leaf { unused: p, value: discarded_first(first) } }
            };
            0 - value
        };
        print(82);
        return Packet { value: picked, unused: 1 / tail };
    }
    @noinline fn work(seed: State, selected: bool, trips: i64, outer: bool, inner: bool, condition: i64, first: i64, last: i64, value: i64, tail: i64) -> State {
        print(70);
        let mut index = 0;
        while index < trips {
            index = index + 1;
            print(71);
            if selected {
                return State { total: packet(outer, inner, condition, first, last, seed.total + value + 0 / value, tail).value };
            }
            print(72);
        }
        print(73);
        return seed;
    }
    fn start(total: i64, selected: bool, trips: i64, outer: bool, inner: bool, condition: i64, first: i64, last: i64, value: i64, tail: i64) -> State {
        print(90);
        return work(State { total: total }, selected, trips, outer, inner, condition, first, last, value, tail);
    }
    fn step(state: State, total: i64, selected: bool, trips: i64, outer: bool, inner: bool, condition: i64, first: i64, last: i64, value: i64, tail: i64) -> State {
        print(91);
        return work(state, selected, trips, outer, inner, condition, first, last, value, tail);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
