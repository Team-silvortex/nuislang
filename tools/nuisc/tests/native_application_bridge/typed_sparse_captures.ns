// Wide immutable state; private selection captures only three payload leaves.
mod cpu Main {
    struct Payload {
        f0: i64,
        f1: i64,
        f2: i64,
        f3: i64,
        f4: i64,
        f5: i64,
        f6: i64,
        f7: i64,
        f8: i64,
        f9: i64,
        f10: i64,
        f11: i64,
        f12: i64,
        f13: i64,
        f14: i64,
        f15: i64,
        f16: i64,
        f17: i64,
        f18: i64,
        f19: i64,
        f20: i64,
        f21: i64,
        f22: i64,
        f23: i64,
        f24: i64,
        f25: i64,
        f26: i64,
        f27: i64,
        f28: i64,
        f29: i64,
        f30: i64,
        f31: i64,
        f32: i64,
        f33: i64,
        f34: i64,
        f35: i64,
        f36: i64,
        f37: i64,
        f38: i64,
        f39: i64,
        f40: i64,
        f41: i64,
        f42: i64,
        f43: i64,
        f44: i64,
        f45: i64,
        f46: i64,
        f47: i64,
        f48: i64,
        f49: i64,
        f50: i64,
        f51: i64,
        f52: i64,
        f53: i64,
        f54: i64,
        f55: i64,
        f56: i64,
        f57: i64,
        f58: i64,
        f59: i64,
        f60: i64,
        f61: i64,
        f62: i64,
        f63: i64,
    }
    struct State { payload: Payload }
    @noinline fn choose(state: State) -> i64 {
        let selected: i64 = if state.payload.f2 > 0 {
            state.payload.f0
        } else {
            state.payload.f63 / state.payload.f1
        };
        return selected;
    }
    fn start(left: i64, divisor: i64, flag: i64, right: i64) -> State {
        return State {
            payload: Payload {
                f0: left,
                f1: divisor,
                f2: flag,
                f3: 3,
                f4: 4,
                f5: 5,
                f6: 6,
                f7: 7,
                f8: 8,
                f9: 9,
                f10: 10,
                f11: 11,
                f12: 12,
                f13: 13,
                f14: 14,
                f15: 15,
                f16: 16,
                f17: 17,
                f18: 18,
                f19: 19,
                f20: 20,
                f21: 21,
                f22: 22,
                f23: 23,
                f24: 24,
                f25: 25,
                f26: 26,
                f27: 27,
                f28: 28,
                f29: 29,
                f30: 30,
                f31: 31,
                f32: 32,
                f33: 33,
                f34: 34,
                f35: 35,
                f36: 36,
                f37: 37,
                f38: 38,
                f39: 39,
                f40: 40,
                f41: 41,
                f42: 42,
                f43: 43,
                f44: 44,
                f45: 45,
                f46: 46,
                f47: 47,
                f48: 48,
                f49: 49,
                f50: 50,
                f51: 51,
                f52: 52,
                f53: 53,
                f54: 54,
                f55: 55,
                f56: 56,
                f57: 57,
                f58: 58,
                f59: 59,
                f60: 60,
                f61: 61,
                f62: 62,
                f63: right,
            }
        };
    }
    fn step(state: State) -> State {
        let selected = choose(state);
        return State {
            payload: Payload {
                f0: selected,
                f1: state.payload.f1,
                f2: state.payload.f2,
                f3: state.payload.f3,
                f4: state.payload.f4,
                f5: state.payload.f5,
                f6: state.payload.f6,
                f7: state.payload.f7,
                f8: state.payload.f8,
                f9: state.payload.f9,
                f10: state.payload.f10,
                f11: state.payload.f11,
                f12: state.payload.f12,
                f13: state.payload.f13,
                f14: state.payload.f14,
                f15: state.payload.f15,
                f16: state.payload.f16,
                f17: state.payload.f17,
                f18: state.payload.f18,
                f19: state.payload.f19,
                f20: state.payload.f20,
                f21: state.payload.f21,
                f22: state.payload.f22,
                f23: state.payload.f23,
                f24: state.payload.f24,
                f25: state.payload.f25,
                f26: state.payload.f26,
                f27: state.payload.f27,
                f28: state.payload.f28,
                f29: state.payload.f29,
                f30: state.payload.f30,
                f31: state.payload.f31,
                f32: state.payload.f32,
                f33: state.payload.f33,
                f34: state.payload.f34,
                f35: state.payload.f35,
                f36: state.payload.f36,
                f37: state.payload.f37,
                f38: state.payload.f38,
                f39: state.payload.f39,
                f40: state.payload.f40,
                f41: state.payload.f41,
                f42: state.payload.f42,
                f43: state.payload.f43,
                f44: state.payload.f44,
                f45: state.payload.f45,
                f46: state.payload.f46,
                f47: state.payload.f47,
                f48: state.payload.f48,
                f49: state.payload.f49,
                f50: state.payload.f50,
                f51: state.payload.f51,
                f52: state.payload.f52,
                f53: state.payload.f53,
                f54: state.payload.f54,
                f55: state.payload.f55,
                f56: state.payload.f56,
                f57: state.payload.f57,
                f58: state.payload.f58,
                f59: state.payload.f59,
                f60: state.payload.f60,
                f61: state.payload.f61,
                f62: state.payload.f62,
                f63: state.payload.f63,
            }
        };
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { print(999); return 0; }
}
