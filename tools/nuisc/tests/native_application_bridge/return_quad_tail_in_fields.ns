        print(76); return (flag != peer) == (proof == 1);
    }
    @noinline fn prefix_work(flag: bool, proof: i64) -> bool { print(73); return flag == (proof == 1); }
    @noinline fn prefix_wide_work(value: f64, narrow: f32, flag: bool, proof: i64) -> f64 {
        print(72); if (narrow < 0.0) != flag { return -value; } else { return value; }
