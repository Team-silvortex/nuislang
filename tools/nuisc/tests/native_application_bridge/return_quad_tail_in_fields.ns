    fn observe(
        seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, bool_seed: bool, peer_seed: bool,
        first: bool, second: bool, outer: i64, init: i64, cond: i64, small_rhs: i64, narrow_rhs: i64,
        wide_rhs: i64, bool_rhs: i64, peer_rhs: i64, parent_rhs: i64, exit_guard: i64, nested: i64, prefix: i64, prefix_wide: i64, prefix_peer: i64, sibling: i64, sibling_small: i64, sibling_wide: i64, sibling_owner: i64, after: i64, answer: i64, tail_cond: i64, tail_pair: i64, tail_no: i64, tail_child: i64
    ) -> bool {
        print(99);
        if choose(first, 1 / outer) {
            let a = small_seed;
            let b = narrow_seed;
            let c = wide_seed;
            let d = bool_seed;
            let e = peer_seed;
            let local = initialize(seed, 1 / init);
            if condition(second, 1 / cond) {
                let a = small_work(a, 1 / small_rhs);
                let b = narrow_work(b, 1 / narrow_rhs);
                if prefix_work(d, 1 / prefix) {
                    let c = prefix_wide_work(c, b, d, 1 / prefix_wide);
                } else {
                    let e = prefix_peer_work(e, 1 / prefix_peer);
                }
                let d = bool_work(d, 1 / bool_rhs);
                if exit_work(local, a, b, c, d, e, 1 / exit_guard) { return d && answer_work(local, seed, 1 / answer); }
                if nested_work(d, 1 / nested) {
                    let c = wide_work(c, b, d, 1 / wide_rhs);
                    let e = e && peer_work(d, 1 / peer_rhs);
                } else {
                    let e = peer_work(d != true, 1 / peer_rhs);
                }
                let local = parent_work(local, a, b, c, d, e, 1 / parent_rhs);
            } else {
                if sibling_work(e, 1 / sibling) {
                    let a = sibling_small_work(a, 1 / sibling_small);
                    let d = bool_work(d, 1 / bool_rhs);
                } else {
                    let c = sibling_wide_work(c, b, d, 1 / sibling_wide);
                }
                let local = sibling_owner_work(local, a, b, c, d, e, 1 / sibling_owner);
            }
            if tail_work(local, a, b, c, d, e, 1 / tail_cond) {
                if d {
                    let c = tail_child_work(c, 1 / tail_child);
                    let d = tail_pair_work(d, c, 1 / tail_pair);
                    let a = tail_third_work(a, d);
                    let b = tail_fourth_work(b, a);
                    let local = tail_yes_work(local, 1);
                }
            } else {
                let local = tail_no_work(local, a, b, c, d, e, 1 / tail_no);
            }
            let ignored = after_work(local, a, b, c, d, e, 1 / after);
            let local = parent_work(local, a, b, c, d, e, 1 / parent_rhs);
            return answer_work(local, seed, 1 / answer) || e;
        } else { return answer_work(seed, seed, 1 / answer) && second; }
        print(80); return false;
    }
    fn start(
        seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, bool_seed: bool, peer_seed: bool,
        first: bool, second: bool, outer: i64, init: i64, cond: i64, small_rhs: i64, narrow_rhs: i64,
        wide_rhs: i64, bool_rhs: i64, peer_rhs: i64, parent_rhs: i64, exit_guard: i64, nested: i64, prefix: i64, prefix_wide: i64, prefix_peer: i64, sibling: i64, sibling_small: i64, sibling_wide: i64, sibling_owner: i64, after: i64, answer: i64, tail_cond: i64, tail_pair: i64, tail_no: i64, tail_child: i64
    ) -> State {
        let result = observe(
