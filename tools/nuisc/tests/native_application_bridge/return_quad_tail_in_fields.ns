        if flag { return value; } else { const minus_one: i32 = i32_from_i64(-1); return minus_one - value; }
    }
    @noinline fn tail_fourth_work(value: f32, small: i32) -> f32 {
        print(60);
        if small < i32_from_i64(0) { return value; } else { return -value; }
    }
    @noinline fn tail_yes_work(value: i64, proof: i64) -> i64 { print(65); return -1 - value; }
    @noinline fn tail_no_work(value: i64, small: i32, narrow: f32, wide: f64, flag: bool, peer: bool, proof: i64) -> i64 {
        print(64);
