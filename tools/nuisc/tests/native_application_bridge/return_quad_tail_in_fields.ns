    @noinline fn prefix_peer_work(value: bool, proof: i64) -> bool { print(77); return value != true; }
    @noinline fn sibling_work(peer: bool, proof: i64) -> bool { print(69); return peer == (proof == 1); }
    @noinline fn sibling_small_work(value: i32, proof: i64) -> i32 {
