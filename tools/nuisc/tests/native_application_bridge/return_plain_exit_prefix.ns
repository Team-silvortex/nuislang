mod cpu Main {
    struct State { result: bool }
    @noinline fn choose(value: bool) -> bool { print(10); return value; }
    @noinline fn select(value: bool, proof: i64) -> bool { print(11); return value == (proof == 1); }
    @noinline fn small(value: i32) -> i32 { print(12); return i32_from_i64(-1) - value; }
    @noinline fn narrow(value: f32) -> f32 { print(13); return -value; }
    @noinline fn wide(value: f64) -> f64 { print(15); return -value; }
    @noinline fn flag(value: bool) -> bool { print(16); return value != true; }
    @noinline fn peer(value: bool) -> bool { print(17); return value != true; }
    @noinline fn exit_condition(value: bool, proof: i64) -> bool { print(14); return value == (proof == 1); }
    @noinline fn exit_owner(value: i64, proof: i64) -> i64 { print(20); return value + 1; }
    @noinline fn sibling_owner(value: i64, proof: i64) -> i64 { print(30); return value + 2; }
    @noinline fn inner_condition(value: bool, proof: i64) -> bool { print(21); return value == (proof == 1); }
    @noinline fn exit_small(value: i32, proof: i64) -> i32 { print(22); return i32_from_i64(-1) - value; }
    @noinline fn exit_narrow(value: f32, small: i32, proof: i64) -> f32 {
        print(23); if small < i32_from_i64(0) { return value; } else { return -value; }
    }
    @noinline fn exit_wide(value: f64, narrow: f32, proof: i64) -> f64 {
        print(24); if narrow < 0.0 { return -value; } else { return value; }
    }
    @noinline fn exit_flag(value: bool, wide: f64, proof: i64) -> bool { print(27); return value != (wide < 0.0); }
    @noinline fn exit_peer(value: bool, flag: bool, proof: i64) -> bool { print(29); return value != flag; }
    @noinline fn tail_owner(value: i64, proof: i64) -> i64 { print(25); return value + 1; }
    @noinline fn tail_work(value: i64, proof: i64) -> i64 { print(26); return value; }
    @noinline fn answer_work(value: i64, small: i32, narrow: f32, wide: f64, flag: bool, peer: bool, proof: i64) -> bool {
        print(28); return (value == 9) && (((small < i32_from_i64(0)) != flag) != (((narrow < 0.0) != (wide < 0.0)) != peer));
    }
    fn observe(seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, flag_seed: bool, peer_seed: bool,
        pick: bool, take: bool, inner: bool, branch: i64, gate: i64, yes_owner: i64, no_owner: i64,
        choice: i64, small_proof: i64, narrow_proof: i64, wide_proof: i64, flag_proof: i64, peer_proof: i64, answer: i64, tail: i64) -> bool {
        if choose(true) {
            let a = small_seed;
            let b = narrow_seed;
            let c = wide_seed;
            let d = flag_seed;
            let e = peer_seed;
            let local = seed;
            if select(pick, 1 / branch) {
                let a = small(a);
                let b = narrow(b);
                let c = wide(c);
                let d = flag(d);
                let e = peer(e);
                if exit_condition(take, 1 / gate) {
                    let local = exit_owner(local, 1 / yes_owner);
                    if inner_condition(inner, 1 / choice) {
                        let a = exit_small(a, 1 / small_proof);
                        let b = exit_narrow(b, a, 1 / narrow_proof);
                        let c = exit_wide(c, b, 1 / wide_proof);
                        let d = exit_flag(d, c, 1 / flag_proof);
                        let e = exit_peer(e, d, 1 / peer_proof);
                    }
                    return answer_work(local, a, b, c, d, e, 1 / answer);
                }
                let local = tail_owner(local, 1 / tail);
            } else {
                let e = peer(e);
                let d = flag(d);
                let c = wide(c);
                let b = narrow(b);
                let a = small(a);
                if exit_condition(take, 1 / gate) {
                    let local = sibling_owner(local, 1 / no_owner);
                    if inner_condition(inner, 1 / choice) {
                        let c = exit_wide(c, b, 1 / wide_proof);
                        let d = exit_flag(d, c, 1 / flag_proof);
                        let a = exit_small(a, 1 / small_proof);
                        let b = exit_narrow(b, a, 1 / narrow_proof);
                        let e = exit_peer(e, d, 1 / peer_proof);
                    }
                    return answer_work(local, a, b, c, d, e, 1 / answer);
                }
                let local = tail_owner(local, 1 / tail);
            }
            let finished = tail_work(local, 1 / tail);
            return answer_work(local, a, b, c, d, e, 1 / answer);
        } else { return false; }
    }
    fn start(seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, flag_seed: bool, peer_seed: bool,
        pick: bool, take: bool, inner: bool, branch: i64, gate: i64, yes_owner: i64, no_owner: i64,
        choice: i64, small_proof: i64, narrow_proof: i64, wide_proof: i64, flag_proof: i64, peer_proof: i64, answer: i64, tail: i64) -> State {
        let result = observe(seed, small_seed, narrow_seed, wide_seed, flag_seed, peer_seed, pick, take, inner,
            branch, gate, yes_owner, no_owner, choice, small_proof, narrow_proof, wide_proof, flag_proof, peer_proof, answer, tail);
        return State { result: result };
    }
    fn step(state: State, seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, flag_seed: bool, peer_seed: bool,
        pick: bool, take: bool, inner: bool, branch: i64, gate: i64, yes_owner: i64, no_owner: i64,
        choice: i64, small_proof: i64, narrow_proof: i64, wide_proof: i64, flag_proof: i64, peer_proof: i64, answer: i64, tail: i64) -> State {
        return start(seed, small_seed, narrow_seed, wide_seed, flag_seed, peer_seed, pick, take, inner,
            branch, gate, yes_owner, no_owner, choice, small_proof, narrow_proof, wide_proof, flag_proof, peer_proof, answer, tail);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
