mod cpu Main {
    struct State {
        seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, bool_seed: bool, peer_seed: bool, first: bool,
        second: bool, outer: i64, init: i64, small_init: i64, narrow_init: i64, wide_init: i64, bool_init: i64,
        peer_init: i64, cond: i64, parent_rhs: i64, small_rhs: i64, narrow_rhs: i64, wide_rhs: i64, bool_rhs: i64,
        peer_rhs: i64, after: i64, unused: i64, answer: i64,
        result: bool
    }
    @noinline fn choose(value: bool, proof: i64) -> bool { print(90); return value == (proof == 1); }
    @noinline fn initialize(value: i64, proof: i64) -> i64 { print(87); return value; }
    @noinline fn small_initial(value: i32, proof: i64) -> i32 { print(88); return value; }
    @noinline fn narrow_initial(value: f32, proof: i64) -> f32 { print(91); return value; }
    @noinline fn wide_initial(value: f64, proof: i64) -> f64 { print(73); return value; }
    @noinline fn bool_initial(value: bool, proof: i64) -> bool { print(82); return value; }
    @noinline fn peer_initial(value: bool, proof: i64) -> bool { print(84); return value; }
    @noinline fn condition(value: bool, proof: i64) -> bool { print(92); return value == (proof == 1); }
    @noinline fn parent_work(value: i64, small: i32, narrow: f32, wide: f64, flag: bool, peer: bool, proof: i64) -> i64 {
        print(95);
        if ((((small < i32_from_i64(0)) != (narrow < 0.0)) != (wide < 0.0)) != flag) != peer {
            return -1 - value;
        } else { return value; }
    }
    @noinline fn small_work(value: i32, proof: i64) -> i32 {
        print(94); const minus_one: i32 = i32_from_i64(-1); return minus_one - value;
    }
    @noinline fn narrow_work(value: f32, proof: i64) -> f32 { print(93); return -value; }
    @noinline fn wide_work(value: f64, narrow: f32, flag: bool, proof: i64) -> f64 {
        print(74); if (narrow < 0.0) != flag { return -value; } else { return value; }
    }
    @noinline fn bool_work(value: bool, proof: i64) -> bool { print(81); return value; }
    @noinline fn peer_work(value: bool, proof: i64) -> bool { print(78); return value; }
    @noinline fn after_work(value: i64, small: i32, narrow: f32, wide: f64, flag: bool, peer: bool, proof: i64) -> i64 {
        print(96); return value;
    }
    @noinline fn unused_work(proof: i64) -> i64 { print(83); return proof; }
    @noinline fn answer_work(value: i64, expected: i64, proof: i64) -> bool { print(97); return (value == expected) == (proof == 1); }
    fn observe(
        seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, bool_seed: bool, peer_seed: bool, first: bool,
        second: bool, outer: i64, init: i64, small_init: i64, narrow_init: i64, wide_init: i64, bool_init: i64,
        peer_init: i64, cond: i64, parent_rhs: i64, small_rhs: i64, narrow_rhs: i64, wide_rhs: i64, bool_rhs: i64,
        peer_rhs: i64, after: i64, unused: i64, answer: i64
    ) -> bool {
        print(99);
        if choose(first, 1 / outer) {
            let local = initialize(seed, 1 / init);
            if second {
                let a = small_initial(small_seed, 1 / small_init);
                let b = narrow_initial(narrow_seed, 1 / narrow_init);
                let c = wide_initial(wide_seed, 1 / wide_init);
                let d = bool_initial(bool_seed, 1 / bool_init);
                let e = peer_initial(peer_seed, 1 / peer_init);
                if condition(b < 0.0, 1 / cond) {
                    let a = small_work(a, 1 / small_rhs);
                    let b = narrow_work(b, 1 / narrow_rhs);
                    let d = bool_work(d != true, 1 / bool_rhs);
                    let e = e && peer_work(d, 1 / peer_rhs);
                    let c = wide_work(c, b, d, 1 / wide_rhs);
                    if a == i32_from_i64(0) {
                        let a = small_work(a, 1 / small_rhs);
                        let d = bool_work(d != true, 1 / bool_rhs);
                        let c = wide_work(c, b, d, 1 / wide_rhs);
                    }
                } else {
                    let e = peer_work(e != true, 1 / peer_rhs);
                    let d = d || bool_work(e, 1 / bool_rhs);
                    let b = narrow_work(b, 1 / narrow_rhs);
                    let a = small_work(a, 1 / small_rhs);
                    let c = wide_work(c, b, d, 1 / wide_rhs);
                    if a == i32_from_i64(-1) {
                        let b = narrow_work(b, 1 / narrow_rhs);
                        let e = peer_work(e != true, 1 / peer_rhs);
                        let c = wide_work(c, b, d, 1 / wide_rhs);
                    }
                }
                let local = after_work(local, a, b, c, d, e, 1 / after);
                let local = parent_work(local, a, b, c, d, e, 1 / parent_rhs);
                if a < i32_from_i64(0) {
                    let e = peer_work(e != true, 1 / peer_rhs);
                    let c = wide_work(c, b, e, 1 / wide_rhs);
                    let local = parent_work(local, a, b, c, d, e, 1 / parent_rhs);
                }
                const small_seal: i32 = a;
                const narrow_seal: f32 = b;
                const wide_seal: f64 = c;
                const bool_seal: bool = d || false;
                const peer_seal: bool = e || false;
                let ignored = unused_work(1 / unused);
            }
            return answer_work(local, seed, 1 / answer) && first;
        } else {
            let local = initialize(seed, 1 / init);
            return answer_work(local, seed, 1 / answer) || second;
        }
        print(80); return false;
    }
    fn start(
        seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, bool_seed: bool, peer_seed: bool, first: bool,
        second: bool, outer: i64, init: i64, small_init: i64, narrow_init: i64, wide_init: i64, bool_init: i64,
        peer_init: i64, cond: i64, parent_rhs: i64, small_rhs: i64, narrow_rhs: i64, wide_rhs: i64, bool_rhs: i64,
        peer_rhs: i64, after: i64, unused: i64, answer: i64
    ) -> State {
        let result = observe(
            seed, small_seed, narrow_seed, wide_seed, bool_seed, peer_seed, first, second, outer, init, small_init,
            narrow_init, wide_init, bool_init, peer_init, cond, parent_rhs, small_rhs, narrow_rhs, wide_rhs, bool_rhs,
            peer_rhs, after, unused, answer
        );
        print(79);
        return State {
            seed: seed, small_seed: small_seed, narrow_seed: narrow_seed, wide_seed: wide_seed, bool_seed: bool_seed,
            peer_seed: peer_seed, first: first, second: second, outer: outer, init: init, small_init: small_init,
            narrow_init: narrow_init, wide_init: wide_init, bool_init: bool_init, peer_init: peer_init, cond: cond,
            parent_rhs: parent_rhs, small_rhs: small_rhs, narrow_rhs: narrow_rhs, wide_rhs: wide_rhs, bool_rhs: bool_rhs,
            peer_rhs: peer_rhs, after: after, unused: unused, answer: answer, result: result
        };
    }
    fn step(
        state: State, first: bool, second: bool, outer: i64, init: i64, small_init: i64, narrow_init: i64,
        wide_init: i64, bool_init: i64, peer_init: i64, cond: i64, parent_rhs: i64, small_rhs: i64, narrow_rhs: i64,
        wide_rhs: i64, bool_rhs: i64, peer_rhs: i64, after: i64, unused: i64, answer: i64
    ) -> State {
        return start(
            state.seed, state.small_seed, state.narrow_seed, state.wide_seed, state.bool_seed, state.peer_seed, first,
            second, outer, init, small_init, narrow_init, wide_init, bool_init, peer_init, cond, parent_rhs, small_rhs,
            narrow_rhs, wide_rhs, bool_rhs, peer_rhs, after, unused, answer
        );
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
