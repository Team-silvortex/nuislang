mod cpu Main {
    struct State { total: i64 }
    struct Packet { value: i64, unused: i64 }
    @noinline fn decide(choice: bool, condition: i64) -> bool {
        let proof = 1 / condition;
        return choice == (proof != 0);
    }
    @noinline fn yes_head(divisor: i64) -> bool { return 1 / divisor != 0; }
    @noinline fn yes_tail(divisor: i64) -> bool { return 1 / divisor != 0; }
    @noinline fn no_head(divisor: i64) -> bool { return 1 / divisor != 0; }
    @noinline fn no_tail(divisor: i64) -> bool { return 1 / divisor != 0; }
    @noinline fn prefix_seed(divisor: i64) -> i64 { return 1 / divisor; }
    @noinline fn prefix_step(seed: i64, divisor: i64) -> i64 { return divisor + 0 / seed; }
    @noinline fn encode(bit: bool, value: i64) -> i64 {
        if bit { return value; }
        return 0;
    }
    @noinline fn packet(choice: bool, condition: i64, rhs: i64, other: i64, value: i64, yes: i64, no: i64, tail: i64, yes_prefix: i64, no_prefix: i64) -> Packet {
        print(81);
        let selected: bool = if decide(choice, condition) && true {
            let seed = prefix_seed(yes_prefix);
            const prepared: i64 = prefix_step(seed, yes);
            const head: bool = yes_head(prepared);
            let unused = 1 / (seed + 1);
            (head && yes_tail(rhs)) || false
        } else {
            let seed = prefix_seed(no_prefix);
            const prepared: i64 = prefix_step(seed, no);
            const head: bool = no_head(prepared);
            let unused = 1 / (seed + 1);
            (head || no_tail(other)) && true
        };
        print(82);
        return Packet { value: encode(selected, value), unused: 1 / tail };
    }
    @noinline fn work(seed: State, selected: bool, trips: i64, choice: bool, condition: i64, rhs: i64, other: i64, value: i64, yes: i64, no: i64, tail: i64, yes_prefix: i64, no_prefix: i64) -> State {
        print(70);
        let mut index = 0;
        while index < trips {
            index = index + 1;
            print(71);
            if selected {
                return State { total: packet(choice, condition, rhs, other, seed.total + value + 0 / value, yes, no, tail, yes_prefix, no_prefix).value };
            }
            print(72);
        }
        print(73);
        return seed;
    }
    fn start(total: i64, selected: bool, trips: i64, choice: bool, condition: i64, rhs: i64, other: i64, value: i64, yes: i64, no: i64, tail: i64, yes_prefix: i64, no_prefix: i64) -> State {
        print(90);
        return work(State { total: total }, selected, trips, choice, condition, rhs, other, value, yes, no, tail, yes_prefix, no_prefix);
    }
    fn step(state: State, total: i64, selected: bool, trips: i64, choice: bool, condition: i64, rhs: i64, other: i64, value: i64, yes: i64, no: i64, tail: i64, yes_prefix: i64, no_prefix: i64) -> State {
        print(91);
        return work(state, selected, trips, choice, condition, rhs, other, value, yes, no, tail, yes_prefix, no_prefix);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
