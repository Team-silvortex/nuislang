mod cpu Main {
    struct State {
        seed: i64, small_seed: i32, float_seed: f64, first: bool, second: bool,
        outer: i64, init: i64, small_init: i64, float_init: i64, cond: i64,
        parent_rhs: i64, small_rhs: i64, float_rhs: i64, after: i64, unused: i64, answer: i64,
        result: bool
    }
    @noinline fn choose(value: bool, proof: i64) -> bool { print(90); return value == (proof == 1); }
    @noinline fn initialize(value: i64, proof: i64) -> i64 { print(87); return value; }
    @noinline fn small_initial(value: i32, proof: i64) -> i32 { print(88); return value; }
    @noinline fn float_initial(value: f64, proof: i64) -> f64 { print(91); return value; }
    @noinline fn condition(value: bool, proof: i64) -> bool { print(92); return value == (proof == 1); }
    @noinline fn parent_work(value: i64, small: i32, child: f64, proof: i64) -> i64 {
        print(95);
        if (small < i32_from_i64(0)) != (child < 0.0) { return -1 - value; } else { return value; }
    }
    @noinline fn small_work(value: i32, proof: i64) -> i32 {
        print(94); const minus_one: i32 = i32_from_i64(-1); return minus_one - value;
    }
    @noinline fn float_work(value: f64, proof: i64) -> f64 { print(93); return -value; }
    @noinline fn after_work(value: i64, small: i32, child: f64, proof: i64) -> i64 { print(96); return value; }
    @noinline fn unused_work(proof: i64) -> i64 { print(83); return proof; }
    @noinline fn answer_work(value: i64, expected: i64, proof: i64) -> bool { print(97); return (value == expected) == (proof == 1); }
    fn observe(seed: i64, small_seed: i32, float_seed: f64, first: bool, second: bool,
        outer: i64, init: i64, small_init: i64, float_init: i64, cond: i64,
        parent_rhs: i64, small_rhs: i64, float_rhs: i64, after: i64, unused: i64, answer: i64) -> bool {
        print(99);
        if choose(first, 1 / outer) {
            let local = initialize(seed, 1 / init);
            if second {
                let a = small_initial(small_seed, 1 / small_init);
                let b = float_initial(float_seed, 1 / float_init);
                if condition(b < 0.0, 1 / cond) {
                    let a = small_work(a, 1 / small_rhs);
                    let b = float_work(b, 1 / float_rhs);
                    if a == i32_from_i64(0) {
                        let a = small_work(a, 1 / small_rhs);
                        let b = float_work(b, 1 / float_rhs);
                    }
                } else {
                    let b = float_work(b, 1 / float_rhs);
                    let a = small_work(a, 1 / small_rhs);
                    if a == i32_from_i64(-1) {
                        let b = float_work(b, 1 / float_rhs);
                        let a = small_work(a, 1 / small_rhs);
                    }
                }
                let local = after_work(local, a, b, 1 / after);
                let local = parent_work(local, a, b, 1 / parent_rhs);
                if a < i32_from_i64(0) { let local = parent_work(local, a, b, 1 / parent_rhs); }
                const small_seal: i32 = a;
                const float_seal: f64 = b;
                let ignored = unused_work(1 / unused);
            }
            return answer_work(local, seed, 1 / answer) && first;
        } else {
            let local = initialize(seed, 1 / init);
            return answer_work(local, seed, 1 / answer) || second;
        }
        print(80); return false;
    }
    fn start(seed: i64, small_seed: i32, float_seed: f64, first: bool, second: bool,
        outer: i64, init: i64, small_init: i64, float_init: i64, cond: i64, parent_rhs: i64,
        small_rhs: i64, float_rhs: i64, after: i64, unused: i64, answer: i64) -> State {
        let result = observe(seed, small_seed, float_seed, first, second, outer, init, small_init,
            float_init, cond, parent_rhs, small_rhs, float_rhs, after, unused, answer);
        print(79);
        return State { seed: seed, small_seed: small_seed, float_seed: float_seed, first: first, second: second,
            outer: outer, init: init, small_init: small_init, float_init: float_init, cond: cond,
            parent_rhs: parent_rhs, small_rhs: small_rhs, float_rhs: float_rhs, after: after,
            unused: unused, answer: answer, result: result };
    }
    fn step(state: State, first: bool, second: bool, outer: i64, init: i64, small_init: i64,
        float_init: i64, cond: i64, parent_rhs: i64, small_rhs: i64, float_rhs: i64,
        after: i64, unused: i64, answer: i64) -> State {
        return start(state.seed, state.small_seed, state.float_seed, first, second, outer, init,
            small_init, float_init, cond, parent_rhs, small_rhs, float_rhs, after, unused, answer);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
