mod cpu Main {
  struct Metrics { total: i64, tag: i32, active: bool, gain: f32, scale: f64 }
  struct State { frame: i64, metrics: Metrics }
  struct Parts { quotient: i64, remainder: i64 }
  struct Tick { value: i64 }

  @noinline
  fn quotient(value: i64, width: i64) -> i64 { return value / width; }
  @noinline
  fn remainder(value: i64, width: i64) -> i64 { return value % width; }
  @noinline
  fn sum(left: i64, right: i64) -> i64 {
    let value: i64 = left + right;
    return quotient(value, 3) * 3 + remainder(value, 3);
  }
  @noinline
  fn counted(value: i64, initial: i64, limit: i64, stop: i64) -> i64 {
    let index: i64 = initial;
    let total: i64 = value;
    let checksum: i64 = 0;
    while index < limit {
      let total: i64 = sum(total, index);
      let checksum: i64 = sum(checksum, total);
      if index == stop {
        let total: i64 = total + 10;
        let checksum: i64 = checksum + total;
        return total + checksum + index;
      }
      if index < stop {
        let total: i64 = total + 2;
        let checksum: i64 = checksum + total;
        let index: i64 = index + 1;
        continue;
      }
      let total: i64 = total + 100;
      let checksum: i64 = checksum + total;
      let index: i64 = index + 1;
    }
    return total + checksum + index;
  }
  @noinline
  fn rebalance(value: i64, width: i64) -> i64 {
    let index: i64 = 0;
    let packet = Parts { quotient: value, remainder: 0 };
    let saved = packet;
    let tick = Tick { value: 0 };
    let gate = value < 0;
    let initial_gate = gate;
    while index < width {
      let child: i64 = 0;
      while child < index {
        let packet = Parts { remainder: packet.remainder + 1, quotient: packet.quotient + index };
        let changed = packet;
        let gate = gate == false;
        let before = gate;
        if gate {
          let packet = Parts { quotient: packet.quotient + 3, remainder: packet.remainder };
          let gate = before;
        } else {
          let packet = changed;
          let gate = before;
        }
        let packet = Parts { quotient: packet.quotient - index, remainder: packet.remainder };
        if gate {
          let packet = Parts { quotient: packet.quotient - 3, remainder: packet.remainder };
        }
        let tick = Tick { value: tick.value + 1 };
        let terminal = index == width;
        let gate = terminal || (gate && quotient(width, width - index) > 0);
        if child == 0 { let child = child + 1; continue; }
        if child == 1 { return packet.quotient + packet.remainder - tick.value + saved.remainder; }
        let packet = Parts { quotient: packet.quotient + 1000, remainder: packet.remainder };
        let child = child + 1;
      }
      // Tail steps run only after the selected effects, never after break.
      if index < 2 { let index = index + 1; continue; }
      if index == 2 { break; }
      let tick = Tick { value: tick.value + 1000 };
      let index = index + 1;
    }
    // Bool and record carries share private words without changing callback state.
    // The old bool snapshot must remain usable after both zero and nonzero trips.
    let remembered = initial_gate == (value < 0);
    if remembered { return packet.quotient + packet.remainder - tick.value + saved.remainder; }
    return 999;
  }
  @noinline
  fn decompose(value: i64, width: i64) -> Parts {
    let index = 0;
    while index < width {
      if index == 0 {
        return Parts { quotient: quotient(rebalance(rebalance(value, 0), width), width), remainder: remainder(value, width) };
      }
      let index = index + 1;
    }
    if value < 0 {
      return Parts { quotient: quotient(rebalance(rebalance(value, 0), width), width), remainder: remainder(value, width) };
    }
    return Parts { quotient: quotient(rebalance(rebalance(value, 0), width), width), remainder: remainder(value, width) };
  }
  @noinline
  fn adjust(value: i64, delta: i64) -> i64 {
    if delta == 0 { return value; }
    let result: i64 = counted(value, delta, delta + 4, delta + 1);
    let corrected: i64 = result - value * 4 - delta * 8 - 32;
    let parts: Parts = decompose(corrected, 3);
    return parts.quotient * 3 + parts.remainder;
  }
  @noinline
  fn zero(limit: i64) -> i64 {
    let index: i64 = 0;
    while index < limit {
      if index == 2 { return index - 2; }
      let index: i64 = index + 1;
    }
    return index - 2;
  }
  @noinline fn keep_tag(value: i32) -> i32 { return value; }
  @noinline fn keep_flag(value: bool) -> bool {
    let index = 0;
    while index < 2 {
      let index = index + 1;
      if index == 1 { return value; }
    }
    return false;
  }
  @noinline fn keep_gain(value: f32) -> f32 { return value; }
  @noinline fn keep_scale(value: f64) -> f64 { return value; }

  fn start(seed: i64, tag: i32, active: bool, gain: f32, scale: f64) -> State {
    return State { frame: zero(4), metrics: Metrics {
      total: adjust(seed, 0), tag: keep_tag(tag), active: keep_flag(active),
      gain: keep_gain(gain), scale: keep_scale(scale)
    } };
  }
  fn step(state: State, delta: i64, paused: bool) -> State {
    if keep_flag(paused) { return state; }
    return State { frame: sum(state.frame, 1), metrics: Metrics {
      total: adjust(state.metrics.total, delta), tag: keep_tag(state.metrics.tag),
      active: keep_flag(state.metrics.active), gain: keep_gain(state.metrics.gain),
      scale: keep_scale(state.metrics.scale)
    } };
  }
  fn stop(state: State, reason: i64) -> State {
    return State { frame: state.frame, metrics: Metrics {
      total: adjust(state.metrics.total, reason), tag: keep_tag(state.metrics.tag),
      active: keep_flag(false), gain: keep_gain(state.metrics.gain),
      scale: keep_scale(state.metrics.scale)
    } };
  }
  fn main() -> i64 { print(999); return 0; }
}
