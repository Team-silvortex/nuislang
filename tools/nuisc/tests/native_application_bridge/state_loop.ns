mod cpu Main {
    struct State { result: bool, total: i64, marker: f64 }
    @noinline fn advance(value: i64, proof: i64) -> i64 { print(5); return value + proof; }
    @noinline fn choose(value: bool, proof: i64) -> bool { return value == (proof == 1); }
    @noinline fn refine(value: i64, proof: i64, index: i64) -> i64 { return value * 2 + proof + index; }
    @noinline fn finish(value: i64, proof: i64) -> i64 { print(35); return value + 3 * proof; }
    @noinline fn answer_work(value: i64, previous: bool, proof: i64) -> bool {
        print(40); return previous != ((value % 2 == 0) && (proof == 1));
    }
    @noinline fn update(value: i64, gate: bool, root: i64, hole: i64, index: i64) -> i64 {
        if choose(gate != (value % 2 == 0), 1 / root) {
            let local = refine(value, 1 / (index - hole), index);
            return local + 1;
        }
        return value + 1;
    }
    @noinline fn walk(value: i64, trips: i64, gate: bool, root: i64, hole: i64) -> i64 {
        let mut current = value;
        let mut index = 0;
        while index < trips {
            current = update(current, gate, root, hole, index);
            index = index + 1;
        }
        return current;
    }
    fn start(seed: i64, gate: bool, flag: bool, trips: i64, root: i64, hole: i64, tail: i64, answer: i64, marker: f64, advancing: i64) -> State {
        let advanced = advance(seed, 1 / advancing);
        let current = walk(advanced, trips, gate != flag, root, hole);
        let total = finish(current, 1 / tail);
        let result = answer_work(total, flag, 1 / answer);
        return State { result: result, total: total, marker: marker };
    }
    fn step(state: State, seed: i64, gate: bool, flag: bool, trips: i64, root: i64, hole: i64, tail: i64, answer: i64, marker: f64, advancing: i64) -> State {
        let advanced = advance(state.total, 1 / advancing);
        let current = walk(advanced, trips, gate != state.result, root, hole);
        let total = finish(current, 1 / tail);
        let result = answer_work(total, state.result, 1 / answer);
        return State { result: result, total: total, marker: state.marker };
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
