mod cpu Main {
    struct State {
        seed: bool, first: bool, second: bool, reply: bool,
        outer: i64, init: i64, cond: i64, before: i64, ancestor: i64,
        child_init: i64, child_cond: i64, child_rhs: i64, parent_rhs: i64, child_after: i64, child_unused: i64, child_tail: i64,
        answer: i64, result: bool
    }
    @noinline fn choose(value: bool, proof: i64) -> bool { print(90); return value == (proof == 1); }
    @noinline fn initialize(value: bool, proof: i64) -> bool { print(87); return value == (proof == 1); }
    @noinline fn condition(value: bool, proof: i64) -> bool { print(88); return value == (proof == 1); }
    @noinline fn before_work(value: bool, proof: i64) -> bool { print(77); return value == (proof == 1); }
    @noinline fn ancestor_work(value: bool, proof: i64) -> bool { print(89); return value == (proof == 1); }
    @noinline fn child_initial(value: bool, proof: i64) -> bool { print(91); return value == (proof == 1); }
    @noinline fn child_condition(value: bool, proof: i64) -> bool { print(92); return value == (proof == 1); }
    @noinline fn child_work(value: bool, proof: i64) -> bool { print(93); return value == (proof == 1); }
    @noinline fn parent_work(value: bool, proof: i64) -> bool { print(95); return value == (proof == 1); }
    @noinline fn after_child_work(value: bool, proof: i64) -> bool { print(96); return value == (proof == 1); }
    @noinline fn child_unused_work(proof: i64) -> i64 { print(83); return proof; }
    @noinline fn child_tail_work(value: bool, proof: i64) -> bool { print(94); return value == (proof == 1); }
    @noinline fn answer_work(value: bool, proof: i64) -> bool { print(97); return value == (proof == 1); }
    fn observe(seed: bool, first: bool, second: bool, reply: bool,
               outer: i64, init: i64, cond: i64, before: i64, ancestor: i64,
               child_init: i64, child_cond: i64, child_rhs: i64, parent_rhs: i64, child_after: i64, child_unused: i64, child_tail: i64, answer: i64) -> bool {
        print(99);
        if choose(first, 1 / outer) {
            let local = initialize(seed, 1 / init);
            if condition(second, 1 / cond) {
                let observed = before_work(local, 1 / before);
                let local = observed || ancestor_work(reply, 1 / ancestor);
                let child = child_initial(local, 1 / child_init);
                if child_condition(reply, 1 / child_cond) {
                    if seed {
                        let local = child && parent_work(second, 1 / parent_rhs);
                        let child = local && child_work(seed, 1 / child_rhs);
                    }
                    const seal: bool = child || child_tail_work(second, 1 / child_tail);
                    let child = after_child_work(child, 1 / child_after);
                    let ignored = child_unused_work(1 / child_unused);
                } else {
                    if seed {} else {
                        let child = child || child_work(second, 1 / child_rhs);
                        let local = child && parent_work(reply, 1 / parent_rhs);
                    }
                    let child = after_child_work(local, 1 / child_after);
                    let ignored = child_unused_work(1 / child_unused);
                }
            } else {
                let local = local && ancestor_work(reply, 1 / ancestor);
                let child = child_initial(local, 1 / child_init);
                if child_condition(reply, 1 / child_cond) {
                    if seed {
                        let child = child || child_work(first, 1 / child_rhs);
                        let local = child && parent_work(second, 1 / parent_rhs);
                    }
                    let child = after_child_work(first, 1 / child_after);
                    let ignored = child_unused_work(1 / child_unused);
                } else {
                    if seed {
                        let local = child || parent_work(first, 1 / parent_rhs);
                        let child = local && child_work(seed, 1 / child_rhs);
                    }
                    let child = after_child_work(child, 1 / child_after);
                    let ignored = child_unused_work(1 / child_unused);
                }
            }
            return local && answer_work(reply, 1 / answer);
        } else {
            let local = initialize(seed, 1 / init);
            if condition(second, 1 / cond) {
                if reply { let local = local && ancestor_work(first, 1 / ancestor); }
                let child = child_initial(local, 1 / child_init);
                if child_condition(reply, 1 / child_cond) {
                    if seed {
                        let local = child || parent_work(seed, 1 / parent_rhs);
                        let child = local && child_work(first, 1 / child_rhs);
                    }
                    const seal: bool = child || child_tail_work(seed, 1 / child_tail);
                    let child = after_child_work(child, 1 / child_after);
                    let ignored = child_unused_work(1 / child_unused);
                } else {
                    if seed {
                        let child = child && child_work(reply, 1 / child_rhs);
                        let local = child || parent_work(seed, 1 / parent_rhs);
                    }
                    let child = after_child_work(local, 1 / child_after);
                    let ignored = child_unused_work(1 / child_unused);
                }
            }
            return local || answer_work(seed, 1 / answer);
        }
        print(80);
        return false;
    }
    fn start(seed: bool, first: bool, second: bool, reply: bool,
             outer: i64, init: i64, cond: i64, before: i64, ancestor: i64,
             child_init: i64, child_cond: i64, child_rhs: i64, parent_rhs: i64, child_after: i64, child_unused: i64, child_tail: i64, answer: i64) -> State {
        let result = observe(seed, first, second, reply, outer, init, cond, before, ancestor, child_init, child_cond, child_rhs, parent_rhs, child_after, child_unused, child_tail, answer);
        print(79);
        return State { seed: seed, first: first, second: second, reply: reply,
            outer: outer, init: init, cond: cond, before: before, ancestor: ancestor,
            child_init: child_init, child_cond: child_cond, child_rhs: child_rhs, parent_rhs: parent_rhs, child_after: child_after, child_unused: child_unused, child_tail: child_tail, answer: answer, result: result };
    }
    fn step(state: State, first: bool, second: bool, reply: bool,
            outer: i64, init: i64, cond: i64, before: i64, ancestor: i64,
            child_init: i64, child_cond: i64, child_rhs: i64, parent_rhs: i64, child_after: i64, child_unused: i64, child_tail: i64, answer: i64) -> State {
        return start(state.seed, first, second, reply, outer, init, cond, before, ancestor, child_init, child_cond, child_rhs, parent_rhs, child_after, child_unused, child_tail, answer);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
