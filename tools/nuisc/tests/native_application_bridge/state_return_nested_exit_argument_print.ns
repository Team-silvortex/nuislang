mod cpu Main {
    struct State { total: f64, control: i64 }

    @noinline fn leaf(value: i64, guard: i64) -> i64 {
        print(80); print(value);
        let checked = 0 / guard;
        print(81);
        return value ^ 4294967296;
    }

    @noinline fn advance(value: i64, outer: bool, inner: bool, left_fault: i64, right_fault: i64, prefix_fault: i64, skip_fault: i64, post_fault: i64) -> i64 {
        let joined: i64 = if outer {
            let staged: i64 = if inner {
                let local = leaf(value + 1, left_fault);
                print(101); print(local);
                local ^ 34359738368
            } else {
                let local = leaf(value - 1, right_fault);
                print(103); print(local);
                local ^ 68719476736
            };
            print(97); print(staged);
            let checked = 0 / prefix_fault;
            print(98);
            staged ^ 17179869184
        } else {
            let staged = value ^ 137438953472;
            print(99); print(staged);
            let checked = 0 / skip_fault;
            print(100);
            staged
        };
        print(95); print(joined);
        let checked = 0 / post_fault;
        print(96);
        return joined;
    }

    @noinline fn work(seed: State, outer: bool, inner: bool, trips: i64, left_fault: i64, right_fault: i64, prefix_fault: i64, skip_fault: i64, post_fault: i64) -> State {
        print(70);
        let mut total = seed.total;
        let mut control = seed.control;
        let mut index = 0;
        while index < trips {
            total = -(-total);
            control = control + 0;
            print(71);
            let next = advance(control, outer, inner, left_fault - index, right_fault - index, prefix_fault - index, skip_fault - index, post_fault - index);
            control = next;
            total = -total;
            print(72);
            index = index + 1;
        }
        print(73);
        return State { total: total, control: control };
    }
    fn start(initial: f64, initial_control: i64, outer: bool, inner: bool, trips: i64, left_fault: i64, right_fault: i64, prefix_fault: i64, skip_fault: i64, post_fault: i64) -> State {
        print(90);
        return work(State { total: initial, control: initial_control }, outer, inner, trips, left_fault, right_fault, prefix_fault, skip_fault, post_fault);
    }
    fn step(state: State, initial: f64, initial_control: i64, outer: bool, inner: bool, trips: i64, left_fault: i64, right_fault: i64, prefix_fault: i64, skip_fault: i64, post_fault: i64) -> State {
        print(91);
        return work(state, outer, inner, trips, left_fault, right_fault, prefix_fault, skip_fault, post_fault);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
