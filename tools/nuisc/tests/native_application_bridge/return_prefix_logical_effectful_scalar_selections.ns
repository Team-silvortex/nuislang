mod cpu Main {
    struct State {
        seed: bool, enabled: bool, first: bool, second: bool, reply: bool,
        da: i64, db: i64, dc: i64, dd: i64, first_gate: i64, second_gate: i64, ya: i64, na: i64, yz: i64, nz: i64, result: bool
    }
    @noinline fn active(gate: bool) -> bool { print(89); return gate; }
    @noinline fn choose_first(gate: bool, proof: i64) -> bool { print(90); return gate == (proof == 1); }
    @noinline fn choose_second(gate: bool, proof: i64) -> bool { print(95); return gate == (proof == 1); }
    @noinline fn expected_first(seed: bool, enabled: bool, reply: bool) -> bool {
        return if enabled { if seed { reply } else { false } } else { seed };
    }
    @noinline fn check1(gate: bool, saved: bool, wanted: bool, proof: i64) -> bool {
        print(91); return gate == ((saved == wanted) == (proof == 1));
    }
    @noinline fn check2(gate: bool, saved: bool, wanted: bool, proof: i64) -> bool {
        print(92); return gate == ((saved == wanted) == (proof == 1));
    }
    @noinline fn check3(saved: bool, wanted: bool, proof: i64) -> bool {
        print(93); return (saved == wanted) == (proof == 1);
    }
    @noinline fn check4(gate: bool, saved: bool, wanted: bool, proof: i64) -> bool {
        print(94); return gate == ((saved == wanted) == (proof == 1));
    }
    @noinline fn prefix(saved: bool, wanted: bool, proof: i64) -> bool {
        print(96); return (saved == wanted) == (proof == 1);
    }
    @noinline fn suffix(proof: i64) -> i64 { print(97); return proof; }
    fn observe(seed: bool, enabled: bool, first: bool, second: bool, reply: bool,
               da: i64, db: i64, dc: i64, dd: i64, first_gate: i64, second_gate: i64, ya: i64, na: i64, yz: i64, nz: i64) -> bool {
        print(99);
        let saved = seed;
        if active(enabled) {
            let saved = saved && check1(reply, saved, seed, 1 / da);
        }
        let wanted = expected_first(seed, enabled, reply);
        if choose_first(first, 1 / first_gate) || choose_second(second, 1 / second_gate) {
            let local = prefix(saved, wanted, 1 / ya);
            let local = local && saved;
            const sealed: bool = local || false;
            let unused = suffix(1 / yz);
            return sealed && check2(reply, local, wanted, 1 / db);
        } else {
            let local = prefix(saved, wanted, 1 / na);
            let local = local && saved;
            const sealed: bool = local || false;
            let unused = suffix(1 / nz);
            return check3(local, wanted, 1 / dc) && (sealed || check4(reply, local, wanted, 1 / dd));
        }
        print(80);
        return false;
    }
    fn start(seed: bool, enabled: bool, first: bool, second: bool, reply: bool,
             da: i64, db: i64, dc: i64, dd: i64, first_gate: i64, second_gate: i64, ya: i64, na: i64, yz: i64, nz: i64) -> State {
        let result = observe(seed, enabled, first, second, reply, da, db, dc, dd, first_gate, second_gate, ya, na, yz, nz);
        print(79);
        return State { seed: seed, enabled: enabled, first: first, second: second, reply: reply,
            da: da, db: db, dc: dc, dd: dd, first_gate: first_gate, second_gate: second_gate, ya: ya, na: na, yz: yz, nz: nz, result: result };
    }
    fn step(state: State, enabled: bool, first: bool, second: bool, reply: bool,
            da: i64, db: i64, dc: i64, dd: i64, first_gate: i64, second_gate: i64, ya: i64, na: i64, yz: i64, nz: i64) -> State {
        return start(state.seed, enabled, first, second, reply, da, db, dc, dd, first_gate, second_gate, ya, na, yz, nz);
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
