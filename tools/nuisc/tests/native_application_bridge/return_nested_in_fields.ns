mod cpu Main {
    struct State {
        seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, bool_seed: bool, peer_seed: bool,
        first: bool, second: bool, outer: i64, init: i64, cond: i64, small_rhs: i64, narrow_rhs: i64,
        wide_rhs: i64, bool_rhs: i64, peer_rhs: i64, parent_rhs: i64, exit_guard: i64, nested: i64, after: i64, answer: i64,
        result: bool
    }
    @noinline fn choose(value: bool, proof: i64) -> bool { print(90); return value == (proof == 1); }
    @noinline fn initialize(value: i64, proof: i64) -> i64 { print(87); return value; }
    @noinline fn condition(value: bool, proof: i64) -> bool { print(92); return value == (proof == 1); }
    @noinline fn small_work(value: i32, proof: i64) -> i32 {
        print(94); const minus_one: i32 = i32_from_i64(-1); return minus_one - value;
    }
    @noinline fn narrow_work(value: f32, proof: i64) -> f32 { print(93); return -value; }
    @noinline fn wide_work(value: f64, narrow: f32, flag: bool, proof: i64) -> f64 {
        print(74); if (narrow < 0.0) != flag { return -value; } else { return value; }
    }
    @noinline fn bool_work(value: bool, proof: i64) -> bool { print(81); return value != true; }
    @noinline fn peer_work(value: bool, proof: i64) -> bool { print(78); return value; }
    @noinline fn parent_work(value: i64, small: i32, narrow: f32, wide: f64, flag: bool, peer: bool, proof: i64) -> i64 {
        print(95);
        if ((((small < i32_from_i64(0)) != (narrow < 0.0)) != (wide < 0.0)) != flag) != peer {
            return -1 - value;
        } else { return value; }
    }
    @noinline fn exit_work(value: i64, small: i32, narrow: f32, wide: f64, flag: bool, peer: bool, proof: i64) -> bool {
        print(76); return (flag != peer) == (proof == 1);
    }
    @noinline fn nested_work(flag: bool, proof: i64) -> bool { print(75); return flag == (proof == 1); }
    @noinline fn after_work(value: i64, small: i32, narrow: f32, wide: f64, flag: bool, peer: bool, proof: i64) -> i64 {
        print(96); return value;
    }
    @noinline fn answer_work(value: i64, expected: i64, proof: i64) -> bool { print(97); return (value == expected) == (proof == 1); }
    fn observe(
        seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, bool_seed: bool, peer_seed: bool,
        first: bool, second: bool, outer: i64, init: i64, cond: i64, small_rhs: i64, narrow_rhs: i64,
        wide_rhs: i64, bool_rhs: i64, peer_rhs: i64, parent_rhs: i64, exit_guard: i64, nested: i64, after: i64, answer: i64
    ) -> bool {
        print(99);
        if choose(first, 1 / outer) {
            let a = small_seed;
            let b = narrow_seed;
            let c = wide_seed;
            let d = bool_seed;
            let e = peer_seed;
            let local = initialize(seed, 1 / init);
            if condition(second, 1 / cond) {
                let a = small_work(a, 1 / small_rhs);
                let b = narrow_work(b, 1 / narrow_rhs);
                let d = bool_work(d, 1 / bool_rhs);
                if exit_work(local, a, b, c, d, e, 1 / exit_guard) { return d && answer_work(local, seed, 1 / answer); }
                if nested_work(d, 1 / nested) {
                    let c = wide_work(c, b, d, 1 / wide_rhs);
                    let e = e && peer_work(d, 1 / peer_rhs);
                } else {
                    let e = peer_work(d != true, 1 / peer_rhs);
                }
                let local = parent_work(local, a, b, c, d, e, 1 / parent_rhs);
            }
            let ignored = after_work(local, a, b, c, d, e, 1 / after);
            let local = parent_work(local, a, b, c, d, e, 1 / parent_rhs);
            return answer_work(local, seed, 1 / answer) || e;
        } else { return answer_work(seed, seed, 1 / answer) && second; }
        print(80); return false;
    }
    fn start(
        seed: i64, small_seed: i32, narrow_seed: f32, wide_seed: f64, bool_seed: bool, peer_seed: bool,
        first: bool, second: bool, outer: i64, init: i64, cond: i64, small_rhs: i64, narrow_rhs: i64,
        wide_rhs: i64, bool_rhs: i64, peer_rhs: i64, parent_rhs: i64, exit_guard: i64, nested: i64, after: i64, answer: i64
    ) -> State {
        let result = observe(
            seed, small_seed, narrow_seed, wide_seed, bool_seed, peer_seed, first, second, outer, init, cond,
            small_rhs, narrow_rhs, wide_rhs, bool_rhs, peer_rhs, parent_rhs, exit_guard, nested, after, answer
        );
        print(79);
        return State {
            seed: seed, small_seed: small_seed, narrow_seed: narrow_seed, wide_seed: wide_seed, bool_seed: bool_seed,
            peer_seed: peer_seed, first: first, second: second, outer: outer, init: init, cond: cond,
            small_rhs: small_rhs, narrow_rhs: narrow_rhs, wide_rhs: wide_rhs, bool_rhs: bool_rhs, peer_rhs: peer_rhs,
            parent_rhs: parent_rhs, exit_guard: exit_guard, nested: nested, after: after, answer: answer, result: result
        };
    }
    fn step(
        state: State, first: bool, second: bool, outer: i64, init: i64, cond: i64, small_rhs: i64, narrow_rhs: i64,
        wide_rhs: i64, bool_rhs: i64, peer_rhs: i64, parent_rhs: i64, exit_guard: i64, nested: i64, after: i64, answer: i64
    ) -> State {
        return start(
            state.seed, state.small_seed, state.narrow_seed, state.wide_seed, state.bool_seed, state.peer_seed,
            first, second, outer, init, cond, small_rhs, narrow_rhs, wide_rhs, bool_rhs, peer_rhs, parent_rhs,
            exit_guard, nested, after, answer
        );
    }
    fn stop(state: State) -> State { return state; }
    fn main() -> i64 { return 0; }
}
