use cpu WitSageContracts;
use kernel WitSageKernelSurface;

mod cpu Main {
  fn main() {
    let features = kernel_tensor(1, 4, "1,2,3,4");
    let shifted = kernel_map_axis(features, "cols", "add_scalar", 10);
    let sum = kernel_reduce_sum_axis(shifted, "cols");
    let first: i64 = kernel_element_at(sum, 0, 0);

    let model_score: i64 =
      WitSageContracts.linear_score_total(4, first, 1, 1);
    let kernel_score: i64 =
      WitSageContracts.kernel_pipeline_total(
        6201,
        1,
        4,
        WitSageContracts.linear_model_kind(),
        WitSageContracts.kernel_reduce_plan_kind(),
        4,
        first
      );

    print(model_score + kernel_score);
  }
}
